// ============================================================
// AiAssistant.h ‚Äî Jarvis AI Chat UI (HYBRID: ImGui Frame + JS Content)
// Phase 9: ImGui = FRAME, HTML/JS = CONTENT
//
// CONCEPT:
// - ImGui renders only the WINDOW FRAME (title bar, border, resize)
// - Content area is EMPTY ‚Äî HTML overlay positions over it
// - JS handles all chat UI (messages, input, model switch, etc)
// - Communication: JS‚Üífetch() for chat, JS‚Üíccall() for draw
//
// FLOW:
// 1. User clicks "J" toolbar button ‚Üí toggle chat panel
// 2. ImGui renders window frame, exports rect to JS
// 3. JS positions HTML overlay over ImGui window content area
// 4. Chat input ‚Üí JS fetch() ‚Üí server.js ‚Üí response ‚Üí JS updates UI
// 5. Draw actions ‚Üí JS ccall() ‚Üí C++ executes on chart
//
// FIX: jarvis_on_response, jarvis_on_error, jarvis_send_to_api
//      are now DEFINED HERE as stubs (Phase 9 = JS handles chat)
//      They exist only for EXPORTED_FUNCTIONS linker compatibility
// ============================================================
#pragma once

#include "imgui.h"
#include "nlohmann/json.hpp"
#include "JarvisBridge.h"
#include <string>
#include <vector>
#include <functional>

using json = nlohmann::json;

// ============================================================
// DATA STRUCTURES
// ============================================================

struct ChatMsg {
    std::string role;       // "user", "assistant", "system"
    std::string content;
    std::string timestamp;
    bool is_error = false;

    // Tool call info
    std::string tool_name;
    std::string tool_args;
    std::string tool_result;
    bool tool_success = false;
    int tool_duration_ms = 0;
};

struct JarvisState {
    bool show_window = false;
    bool is_loading = false;
    std::string error_msg;
    std::string input_buf;
    std::string response_buf;

    std::vector<ChatMsg> messages;

    // UI state
    float scroll_to_bottom = -1.0f;
    bool input_focused = false;
    int msg_id_counter = 0;

    // ‚îÄ‚îÄ Window rect for JS overlay positioning ‚îÄ‚îÄ
    float win_x = 0, win_y = 0, win_w = 480, win_h = 600;
    float content_x = 0, content_y = 0, content_w = 0, content_h = 0;
    bool was_visible = false;
};

// Global state
static JarvisState g_jarvis;

// ============================================================
// HISTORY FORMAT FOR API
// ============================================================
static json BuildHistory(const std::vector<ChatMsg>& msgs, int maxPairs = 10) {
    json arr = json::array();
    int start = (int)msgs.size() - maxPairs * 2;
    if (start < 0) start = 0;
    for (int i = start; i < (int)msgs.size(); i++) {
        arr.push_back({
            {"role", msgs[i].role},
            {"content", msgs[i].content}
        });
    }
    return arr;
}

// ============================================================
// C-LINKAGE ‚Äî All exported functions defined HERE
// In Phase 9 hybrid mode:
//   - jarvis_on_response / jarvis_on_error = STUBS (JS handles chat)
//   - jarvis_send_to_api = STUB (JS uses fetch() directly)
//   - jarvis_execute_draw = REAL (JS calls this for draw actions)
//   - jarvis_get_win_* = REAL (JS reads ImGui window rect)
//   - jarvis_get_chart_status / jarvis_get_tool_data = REAL (JS reads C++ data)
// ============================================================
extern "C" {

// ‚îÄ‚îÄ BACKWARD COMPAT STUBS (exported in build_web.bat) ‚îÄ‚îÄ
// JS now handles chat directly via fetch(), these are no-ops

EMSCRIPTEN_KEEPALIVE
void jarvis_on_response(const char* response_json) {
    // Phase 9: JS handles responses directly via fetch()
    // This stub exists for EXPORTED_FUNCTIONS compatibility
    printf("[JARVIS-C++] jarvis_on_response (legacy stub, JS handles chat)\n");
}

EMSCRIPTEN_KEEPALIVE
void jarvis_on_error(const char* err_text) {
    // Phase 9: JS handles errors directly
    // This stub exists for EXPORTED_FUNCTIONS compatibility
    printf("[JARVIS-C++] jarvis_on_error: %s (legacy stub)\n",
           err_text ? err_text : "null");
}

EMSCRIPTEN_KEEPALIVE
void jarvis_send_to_api(const char* message_json) {
    // Phase 9: JS sends chat via fetch() directly
    // This stub exists for EXPORTED_FUNCTIONS compatibility
    printf("[JARVIS-C++] jarvis_send_to_api (legacy stub, JS uses fetch())\n");
}

// ‚îÄ‚îÄ JS reads these to position HTML overlay ‚îÄ‚îÄ
// Returns NORMALIZED coords (0.0-1.0) relative to display size

EMSCRIPTEN_KEEPALIVE
float jarvis_get_win_x() { return g_jarvis.content_x; }

EMSCRIPTEN_KEEPALIVE
float jarvis_get_win_y() { return g_jarvis.content_y; }

EMSCRIPTEN_KEEPALIVE
float jarvis_get_win_w() { return g_jarvis.content_w; }

EMSCRIPTEN_KEEPALIVE
float jarvis_get_win_h() { return g_jarvis.content_h; }

EMSCRIPTEN_KEEPALIVE
int jarvis_is_visible() { return g_jarvis.show_window ? 1 : 0; }

// ‚îÄ‚îÄ JS calls this to execute draw actions from AI response ‚îÄ‚îÄ
EMSCRIPTEN_KEEPALIVE
void jarvis_execute_draw(const char* actions_json) {
    try {
        json actions = json::parse(actions_json);
        json drawActions = json::array();
        bool hasDrawActions = false;

        for (const auto& action : actions) {
            std::string act_name = action.value("tool", "");
            json act_args = action.value("arguments", json::object());
            bool act_success = action.value("result", json::object()).value("success", false);

            if (!act_success) continue;

            // Symbol & Indicator tools
            if (act_name == "chart_add_symbol" && act_args.contains("symbol")) {
                std::string sym = act_args["symbol"].get<std::string>();
                JarvisBridge_AddSymbol(sym);
            }
            else if (act_name == "chart_add_indicator" && act_args.contains("symbol")) {
                std::string ind   = act_args.value("indicator", "");
                int period        = act_args.value("period", 14);
                JarvisBridge_AddIndicator(ind, period);
            }
            // Draw tools ‚Äî collect for bulk render
            else if (act_name == "chart_draw_line" ||
                     act_name == "chart_draw_fibonacci" ||
                     act_name == "chart_draw_elliott" ||
                     act_name == "chart_draw_ob" ||
                     act_name == "chart_draw_bos" ||
                     act_name == "chart_draw_hline") {
                drawActions.push_back(action);
                hasDrawActions = true;
            }
            // SMC all ‚Äî auto-render
            else if (act_name == "chart_draw_smc_all") {
                JarvisBridge_DrawSMCAll();
            }
        }

        // Bulk render draw actions
        if (hasDrawActions) {
            JarvisBridge_ExecuteDrawActions(drawActions.dump());
        }

        printf("[JARVIS-C++] Executed %d actions from JS\n", (int)actions.size());

    } catch (const std::exception& e) {
        printf("[JARVIS-C++] Draw action error: %s\n", e.what());
    }
}

// ‚îÄ‚îÄ JS calls this to toggle window visibility ‚îÄ‚îÄ
EMSCRIPTEN_KEEPALIVE
void jarvis_toggle_window() {
    g_jarvis.show_window = !g_jarvis.show_window;
}

// ‚îÄ‚îÄ JS calls this to get chart status for API request ‚îÄ‚îÄ
EMSCRIPTEN_KEEPALIVE
const char* jarvis_get_chart_status() {
    static std::string status;
    status = JarvisBridge_GetChartStatus();
    return status.c_str();
}

// ‚îÄ‚îÄ JS calls this to get tool data for API request ‚îÄ‚îÄ
EMSCRIPTEN_KEEPALIVE
const char* jarvis_get_tool_data() {
    static std::string toolData;
    json td;
    try {
        td["swing_analysis"] = json::parse(JarvisBridge_GetSwingAnalysis());
        td["key_levels"]    = json::parse(JarvisBridge_GetKeyLevels());
        td["smc_analysis"]  = json::parse(JarvisBridge_GetSMCAnalysis());
    } catch (...) {}
    toolData = td.dump();
    return toolData.c_str();
}

} // extern "C"

// ============================================================
// RENDER ‚Äî ImGui Frame Only (content handled by JS overlay)
// ============================================================
static void RenderJarvisWindow() {
    if (!g_jarvis.show_window) {
        g_jarvis.was_visible = false;
        return;
    }

    ImGui::SetNextWindowSize(ImVec2(420, 620), ImGuiCond_FirstUseEver);
    ImGuiWindowFlags flags = ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse;

    if (!ImGui::Begin("Jarvis AI", &g_jarvis.show_window, flags)) {
        ImGui::End();
        return;
    }

    // ‚îÄ‚îÄ Track window rect for JS overlay ‚îÄ‚îÄ
    ImVec2 pos = ImGui::GetWindowPos();
    ImVec2 size = ImGui::GetWindowSize();
    ImVec2 contentPos = ImGui::GetCursorScreenPos();
    ImVec2 contentAvail = ImGui::GetContentRegionAvail();

    // Get display size for normalization
    ImVec2 displaySize = ImGui::GetIO().DisplaySize;

    // Store NORMALIZED coordinates (0.0-1.0) for JS
    g_jarvis.win_x = pos.x / displaySize.x;
    g_jarvis.win_y = pos.y / displaySize.y;
    g_jarvis.win_w = size.x / displaySize.x;
    g_jarvis.win_h = size.y / displaySize.y;

    // Content area (below title bar)
    g_jarvis.content_x = contentPos.x / displaySize.x;
    g_jarvis.content_y = contentPos.y / displaySize.y;
    g_jarvis.content_w = contentAvail.x / displaySize.x;
    g_jarvis.content_h = contentAvail.y / displaySize.y;

    g_jarvis.was_visible = true;

    // ‚îÄ‚îÄ FRAME CONTENT: Subtle placeholder background ‚îÄ‚îÄ
    // The JS overlay will render on top of this area
    ImDrawList* dl = ImGui::GetWindowDrawList();
    ImVec2 cMin = contentPos;
    ImVec2 cMax = ImVec2(contentPos.x + contentAvail.x, contentPos.y + contentAvail.y);

    // Subtle content area background
    dl->AddRectFilled(cMin, cMax, IM_COL32(10, 10, 15, 255), 4.0f);

    // Loading spinner in ImGui (as fallback if JS overlay isn't ready)
    if (g_jarvis.is_loading) {
        float titleBarH = ImGui::GetFrameHeight() + ImGui::GetStyle().FramePadding.y * 2;
        ImGui::SetCursorPos(ImVec2(size.x * 0.5f - 60, titleBarH + 30));
        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.4f, 0.8f, 0.4f, 0.6f));
        float t = ImGui::GetTime();
        int dots = ((int)(t * 2.5f)) % 3 + 1;
        std::string dotsStr(dots, '.');
        ImGui::Text("Jarvis%s thinking...", dotsStr.c_str());
        ImGui::PopStyleColor();
    }

    ImGui::End();
}

// ============================================================
// TOOLBAR BUTTON
// ============================================================
static void RenderJarvisToolbarButton() {
    // Capture state BEFORE button click can modify it!
    // This prevents Push/Pop mismatch when show_window changes mid-frame
    bool isOpen = g_jarvis.show_window;

    // Always push exactly 3 colors ‚Äî pick active or inactive set
    if (isOpen) {
        // Active state ‚Äî green glow when chat is open
        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.1f, 0.3f, 0.15f, 1.0f));
        ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.15f, 0.4f, 0.2f, 1.0f));
        ImGui::PushStyleColor(ImGuiCol_ButtonActive, ImVec4(0.12f, 0.35f, 0.18f, 1.0f));
    } else {
        // Inactive state ‚Äî dark button
        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.15f, 0.15f, 0.2f, 1.0f));
        ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.25f, 0.25f, 0.35f, 1.0f));
        ImGui::PushStyleColor(ImGuiCol_ButtonActive, ImVec4(0.2f, 0.2f, 0.3f, 1.0f));
    }

    if (ImGui::Button("J", ImVec2(g_iconSize, g_iconSize))) {
        g_jarvis.show_window = !g_jarvis.show_window;
        if (g_jarvis.show_window) {
            g_jarvis.input_focused = true;
        }
    }

    if (ImGui::IsItemHovered()) {
        ImGui::SetTooltip("Jarvis AI Chat");
    }

    // Always pop exactly 3 ‚Äî matches the 3 pushes above
    ImGui::PopStyleColor(3);
}
