// ============================================================
// SMC SHAPE ID TRACKER
// Tracking shape IDs yang dibuat oleh JarvisDrawSMCAll.
// Sebelum redraw, hapus shapes lama by ID ‚Äî tanpa ubah GlobalShapeManager!
// Nanti kalau ada indicator baru (ICT, Wyckoff, dll), buat tracker sendiri.
// ============================================================
static std::vector<std::string> g_smcShapeIds;

static void JarvisSMCClearOldShapes() {
    for (const auto& id : g_smcShapeIds) {
        g_shapes.RemoveShape(id);
    }
    g_smcShapeIds.clear();
}

static void JarvisSMCTrackNewShapes(size_t countBefore) {
    auto& allShapes = g_shapes.GetEditableShapes();
    for (size_t si = countBefore; si < allShapes.size(); si++) {
        g_smcShapeIds.push_back(allShapes[si].id);
    }
}

// ============================================================
// COLOR PARSER ‚Äî String ‚Üí ImVec4
// ============================================================
static ImVec4 JarvisParseColor(const std::string& colorStr) {
    // Normalize ke lowercase
    std::string c = colorStr;
    for (auto& ch : c) ch = std::tolower(ch);

    // Named colors
    if (c == "green"  || c == "support")    return ImVec4(0.0f,  0.85f, 0.3f,  1.0f);
    if (c == "lime")                         return ImVec4(0.0f,  1.0f,  0.0f,  1.0f);  // bright green for TP
    if (c == "red"    || c == "resistance")  return ImVec4(0.9f,  0.2f,  0.2f,  1.0f);
    if (c == "blue")                         return ImVec4(0.2f,  0.5f,  1.0f,  1.0f);
    if (c == "yellow" || c == "gold")        return ImVec4(1.0f,  0.85f, 0.0f,  1.0f);
    if (c == "orange" || c == "amber")       return ImVec4(1.0f,  0.6f,  0.1f,  1.0f);
    if (c == "cyan"   || c == "aqua")        return ImVec4(0.0f,  1.0f,  1.0f,  1.0f);
    if (c == "magenta"|| c == "pink")        return ImVec4(1.0f,  0.3f,  0.7f,  1.0f);
    if (c == "white")                        return ImVec4(1.0f,  1.0f,  1.0f,  1.0f);
    if (c == "gray"   || c == "grey")        return ImVec4(0.5f,  0.5f,  0.5f,  1.0f);
    if (c == "purple" || c == "violet")      return ImVec4(0.6f,  0.3f,  1.0f,  1.0f);

    // Default untuk support/resistance
    if (c.find("support") != std::string::npos)    return ImVec4(0.0f, 0.85f, 0.3f, 1.0f);
    if (c.find("resist") != std::string::npos)     return ImVec4(0.9f, 0.2f,  0.2f, 1.0f);

    // Auto: default putih
    return ImVec4(1.0f, 1.0f, 1.0f, 0.9f);
}

// ============================================================
// LINE STYLE PARSER ‚Äî String ‚Üí int
// ============================================================
static int JarvisParseLineStyle(const std::string& styleStr) {
    std::string s = styleStr;
    for (auto& ch : s) ch = std::tolower(ch);

    if (s == "solid")   return 0;
    if (s == "dashed")  return 1;
    if (s == "dotted")  return 2;
    return 0; // default solid
}

// ============================================================
// CANDLE INDEX ‚Üí TIME CONVERTER
// Konversi candle_index ke waktu (unix timestamp)
// agar shape bisa diposisikan di chart dengan benar
// ============================================================
static bool JarvisCandleIndexToTime(int candle_index, double& outTime) {
    auto it = g_allCandles.find(g_activeTF);
    if (it == g_allCandles.end() || it->second.empty()) {
        printf("[JarvisDraw] No candle data for TF %s\n", g_activeTF.c_str());
        return false;
    }

    const auto& candles = it->second;
    int n = (int)candles.size();

    // Clamp index ke range valid
    int idx = candle_index;
    if (idx < 0)        idx = 0;
    if (idx >= n)       idx = n - 1;

    outTime = candles[idx].time;
    return true;
}

// ============================================================
// AUTO COLOR LOGIC ‚Äî Berdasarkan arah garis
// Untuk horizontal line: price1 == price0
//   Jika harga ini di ATAS current price ‚Üí resistance (merah)
//   Jika harga ini di BAWAH current price ‚Üí support (hijau)
// ============================================================
static ImVec4 JarvisAutoLineColor(double price0, double price1) {
    auto it = g_allCandles.find(g_activeTF);
    if (it == g_allCandles.end() || it->second.empty()) {
        return ImVec4(1.0f, 1.0f, 1.0f, 0.9f); // putih default
    }
    double currentPrice = it->second.back().close;
    double linePrice = (price0 + price1) * 0.5;

    if (linePrice >= currentPrice) {
        return ImVec4(0.9f, 0.2f, 0.2f, 1.0f); // merah = resistance
    } else {
        return ImVec4(0.0f, 0.85f, 0.3f, 1.0f); // hijau = support
    }
}

// ============================================================
// TOOL 1: chart_draw_line
// Menggambar garis (support/resistance/trendline) di chart
// ============================================================
struct JarvisLineParams {
    std::string style   = "dotted";    // solid | dashed | dotted
    std::string extend  = "right";     // none | left | right | both
    int p0_candle_index = 0;
    double p0_price     = 0.0;
    int p1_candle_index = 0;
    double p1_price     = 0.0;
    std::string label   = "";          // opsional: "Support (3x test)"
    std::string color   = "auto";      // auto | green | red | blue | yellow | dll
    float thickness     = 1.2f;
    std::string description = "";      // PENJELASAN: "Liquidity zone, 3x test" / "Double top reversal"
    bool showPriceTag  = true;         // Tampilkan price tag di right edge (ala TradingView)
};

static bool JarvisDrawLine(const JarvisLineParams& params) {
    // ‚îÄ‚îÄ VALIDASI: Cegah garis degenerate yang bisa crash ImGui ‚îÄ‚îÄ
    // Jika p0 dan p1 di candle index SAMA dan harga SAMA = titik identik = ZERO-LENGTH LINE
    // Dengan extend=right, ini akan menghasilkan TERLALU BANYAK vertices ‚Üí CRASH!
    bool sameIndex = (params.p0_candle_index == params.p1_candle_index);
    bool samePrice = (std::abs(params.p0_price - params.p1_price) < 0.0001);
    if (sameIndex && samePrice) {
        printf("[JarvisDraw] LINE REJECTED: p0==p1 identik (idx=%d, price=%.2f). Garis degenerate = crash risk!\n",
               params.p0_candle_index, params.p0_price);
        return false;
    }

    // Untuk garis horizontal S/R: p0 dan p1 harus beda candle minimal 5
    // Kalau harga sama tapi candle index sama, auto-adjust p1 ke p0+50
    int adj_p1_idx = params.p1_candle_index;
    if (samePrice && sameIndex) {
        auto it = g_allCandles.find(g_activeTF);
        if (it != g_allCandles.end()) {
            int totalCandles = (int)it->second.size();
            adj_p1_idx = std::min(params.p0_candle_index + 50, totalCandles - 1);
            printf("[JarvisDraw] LINE AUTO-FIX: p1_idx adjusted %d‚Üí%d (horizontal S/R)\n",
                   params.p1_candle_index, adj_p1_idx);
        }
    }

    // ‚îÄ‚îÄ SMART GUARD RAILS: Perbaiki keputusan AI yang bodoh (8b model) ‚îÄ‚îÄ
    // C++ engine yang menentukan extend/style terbaik berdasarkan DATA,
    // bukan cuma mengikuti parameter AI yang mungkin salah
    JarvisLineParams fixedParams = params; // copy untuk di-fix

    // GUARD 1: Trendline (diagonal) TIDAK BOLEH extend!
    // Trendline itu garis diagonal ‚Äî kalau di-extend jadi horizontal = salah total
    bool isHorizontal = (std::abs(fixedParams.p0_price - fixedParams.p1_price) < 0.0001);
    if (!isHorizontal && (fixedParams.extend == "right" || fixedParams.extend == "both" || fixedParams.extend == "left")) {
        printf("[JarvisDraw] GUARD-1: Trendline (diagonal) auto-fix extend=%s‚Üínone! AI salah kirim extend untuk garis miring.\n",
               fixedParams.extend.c_str());
        fixedParams.extend = "none";
        // Override style ke solid untuk trendline
        if (fixedParams.style == "dotted") {
            fixedParams.style = "solid";
            printf("[JarvisDraw] GUARD-1b: Trendline auto-fix style=dotted‚Üísolid\n");
        }
    }

    // GUARD 2: Horizontal S/R harus punya minimal 5 candle jarak
    // Kalau AI kirim p0_idx dan p1_idx terlalu dekat, auto-adjust
    if (isHorizontal && std::abs(fixedParams.p1_candle_index - fixedParams.p0_candle_index) < 5) {
        auto it_g2 = g_allCandles.find(g_activeTF);
        if (it_g2 != g_allCandles.end()) {
            int totalCandles = (int)it_g2->second.size();
            adj_p1_idx = std::min(fixedParams.p0_candle_index + 50, totalCandles - 1);
            printf("[JarvisDraw] GUARD-2: Horizontal S/R candleDist<5, auto-adjust p1_idx %d‚Üí%d\n",
                   fixedParams.p1_candle_index, adj_p1_idx);
            fixedParams.p1_candle_index = adj_p1_idx;
        }
    }

    // GUARD 3: Kalau AI lupa isi label untuk horizontal S/R, auto-generate
    if (isHorizontal && fixedParams.label.empty()) {
        auto it_g3 = g_allCandles.find(g_activeTF);
        if (it_g3 != g_allCandles.end() && !it_g3->second.empty()) {
            double currentPrice = it_g3->second.back().close;
            double linePrice = (fixedParams.p0_price + fixedParams.p1_price) * 0.5;
            if (linePrice >= currentPrice) {
                fixedParams.label = "Resistance";
            } else {
                fixedParams.label = "Support";
            }
            printf("[JarvisDraw] GUARD-3: AI lupa label, auto-generate: \"%s\"\n", fixedParams.label.c_str());
        }
    }

    // GUARD 4: Kalau AI lupa isi description untuk horizontal S/R, auto-generate basic
    if (isHorizontal && fixedParams.description.empty()) {
        auto it_g4 = g_allCandles.find(g_activeTF);
        if (it_g4 != g_allCandles.end() && !it_g4->second.empty()) {
            double currentPrice = it_g4->second.back().close;
            double linePrice = (fixedParams.p0_price + fixedParams.p1_price) * 0.5;
            double pctDist = std::abs(linePrice - currentPrice) / currentPrice * 100.0;
            char descBuf[128];
            if (pctDist < 0.5) {
                snprintf(descBuf, sizeof(descBuf), "Dekat harga saat ini (%.1f%%)", pctDist);
            } else if (pctDist < 2.0) {
                snprintf(descBuf, sizeof(descBuf), "Level menengah (%.1f%% dari harga)", pctDist);
            } else {
                snprintf(descBuf, sizeof(descBuf), "Level jauh (%.1f%% dari harga)", pctDist);
            }
            fixedParams.description = descBuf;
            printf("[JarvisDraw] GUARD-4: AI lupa description, auto-generate: \"%s\"\n", descBuf);
        }
    }

    // 1. Konversi candle_index ‚Üí time (pakai fixedParams yang sudah di-guard)
    double time0, time1;
    if (!JarvisCandleIndexToTime(fixedParams.p0_candle_index, time0)) return false;
    if (!JarvisCandleIndexToTime(adj_p1_idx, time1)) return false;

    // 2. Tentukan warna
    ImVec4 col;
    if (fixedParams.color == "auto" || fixedParams.color == "AUTO") {
        col = JarvisAutoLineColor(fixedParams.p0_price, fixedParams.p1_price);
    } else {
        col = JarvisParseColor(fixedParams.color);
    }

    // 3. OPTIMASI: Untuk garis horizontal (S/R) yang di-extend,
    //    gunakan SOLID style karena dotted/dashed membuat TERLALU BANYAK
    //    vertices dan bisa crash ImGui (16-bit vertex limit = 65535)
    bool isHorizontalSR = (fixedParams.p0_price == fixedParams.p1_price) &&
                          (fixedParams.extend == "right" || fixedParams.extend == "both" ||
                           fixedParams.extend == "left");
    std::string effectiveStyle = fixedParams.style;
    if (isHorizontalSR && (fixedParams.style == "dotted" || fixedParams.style == "dashed")) {
        // Override ke solid untuk horizontal extended lines ‚Äî hemat vertex!
        effectiveStyle = "solid";
    }

    // 4. Hitung jarak candle antara p0 dan p1
    //    Jika terlalu dekat (< 3 candle), jangan extend ‚Äî risiko vertex overflow
    int candleDist = std::abs(adj_p1_idx - fixedParams.p0_candle_index);
    bool tooClose = (candleDist < 3);

    // 5. Buat shape LINE
    g_shapes.AddShape("LINE", time0, fixedParams.p0_price, time1, fixedParams.p1_price,
                      col, fixedParams.thickness, false);

    // 6. Set properties tambahan (lineStyle, extend)
    auto& shapes = g_shapes.GetEditableShapes();
    if (!shapes.empty()) {
        auto& shape = shapes.back();
        shape.lineStyle = JarvisParseLineStyle(effectiveStyle);

        std::string ext = fixedParams.extend;
        for (auto& ch : ext) ch = std::tolower(ch);

        // SAFETY: Jika p0 dan p1 terlalu dekat, DISABLE extend ‚Äî cegah vertex overflow
        if (tooClose) {
            shape.extendLeft  = false;
            shape.extendRight = false;
            printf("[JarvisDraw] LINE SAFETY: extend DISABLED (candleDist=%d < 3)\n", candleDist);
        } else {
            shape.extendLeft  = (ext == "left" || ext == "both");
            shape.extendRight = (ext == "right" || ext == "both");
        }
    }

    // 6. Tambah label TEXT kalau ada
    //    Untuk garis yang di-extend ke kanan: label di RIGHT EDGE (price axis style)
    //    Untuk garis biasa: label di P0 position
    if (!fixedParams.label.empty() || fixedParams.showPriceTag) {
        GlobalShape textShape;
        textShape.id = g_shapes.GenerateUUID();
        textShape.type = "TEXT";
        textShape.color = col;
        textShape.textBg = true;
        textShape.textBgColor = ImVec4(0.0f, 0.0f, 0.0f, 0.8f);

        // Build label text: combine label + description + price
        std::string fullLabel;
        if (!fixedParams.label.empty()) {
            fullLabel = fixedParams.label;
        }
        if (!fixedParams.description.empty()) {
            if (!fullLabel.empty()) fullLabel += " - ";
            fullLabel += fixedParams.description;
        }
        // Auto-append price to label
        if (fixedParams.showPriceTag && !fullLabel.empty()) {
            char priceBuf[32];
            snprintf(priceBuf, sizeof(priceBuf), " $%.2f", (fixedParams.p0_price + fixedParams.p1_price) * 0.5);
            fullLabel += priceBuf;
        } else if (fixedParams.showPriceTag && fullLabel.empty()) {
            // Hanya harga, tanpa label
            char priceBuf[32];
            snprintf(priceBuf, sizeof(priceBuf), "$%.2f", (fixedParams.p0_price + fixedParams.p1_price) * 0.5);
            fullLabel = priceBuf;
        }

        textShape.textContent = fullLabel;
        textShape.fontSize = 12.0f;

        // POSISI LABEL: Jika garis di-extend ke kanan, taruh di right edge
        // Seperti TradingView: label muncul di price axis (kanan chart)
        bool extendR = (fixedParams.extend == "right" || fixedParams.extend == "both");
        if (extendR && !tooClose) {
            // Label di right edge: gunakan candle terakhir sebagai time0
            auto it = g_allCandles.find(g_activeTF);
            if (it != g_allCandles.end() && !it->second.empty()) {
                // Taruh label di candle terakhir (right edge chart)
                double lastCandleTime = it->second.back().time;
                textShape.time0 = lastCandleTime;
                textShape.price0 = (fixedParams.p0_price + fixedParams.p1_price) * 0.5;
            } else {
                textShape.time0 = time0;
                textShape.price0 = fixedParams.p0_price;
            }
        } else {
            // Label di P0 (awal garis)
            textShape.time0 = time0;
            textShape.price0 = fixedParams.p0_price;
        }

        g_shapes.AddShape(textShape);
    }

    printf("[JarvisDraw] LINE: style=%s (effective=%s) extend=%s (%d,%.2f)‚Üí(%d,%.2f) dist=%d label=\"%s\" desc=\"%s\"\n",
           fixedParams.style.c_str(), effectiveStyle.c_str(), fixedParams.extend.c_str(),
           fixedParams.p0_candle_index, fixedParams.p0_price,
           adj_p1_idx, fixedParams.p1_price, candleDist,
           fixedParams.label.c_str(), fixedParams.description.c_str());

    return true;
}

// ============================================================
// TOOL 2: chart_draw_fibonacci
// Menggambar Fibonacci Retracement dari swing low ‚Üí swing high
// ============================================================
struct JarvisFibParams {
    int swing_low_index   = 0;
    double swing_low_price  = 0.0;
    int swing_high_index  = 0;
    double swing_high_price = 0.0;
};

static bool JarvisDrawFibonacci(const JarvisFibParams& params) {
    // VALIDASI: Swing low dan high harus beda index dan beda harga
    if (params.swing_low_index == params.swing_high_index) {
        printf("[JarvisDraw] FIB REJECTED: swing_low_index == swing_high_index (%d). Harus beda!\n",
               params.swing_low_index);
        return false;
    }
    if (std::abs(params.swing_low_price - params.swing_high_price) < 0.0001) {
        printf("[JarvisDraw] FIB REJECTED: prices sama (%.2f). Fibo butuh range harga!\n",
               params.swing_low_price);
        return false;
    }

    // 1. Konversi candle_index ‚Üí time
    double timeLow, timeHigh;
    if (!JarvisCandleIndexToTime(params.swing_low_index, timeLow)) return false;
    if (!JarvisCandleIndexToTime(params.swing_high_index, timeHigh)) return false;

    // 2. P0 = swing low (bawah), P1 = swing high (atas)
    //    Fib selalu digambar dari low ‚Üí high
    double p0_time  = timeLow;
    double p0_price = params.swing_low_price;
    double p1_time  = timeHigh;
    double p1_price = params.swing_high_price;

    // 3. Warna default Fibonacci (putih/emas)
    ImVec4 fibColor = ImVec4(1.0f, 0.85f, 0.0f, 0.9f); // gold/amber

    // 4. Buat shape FIB
    g_shapes.AddShape("FIB", p0_time, p0_price, p1_time, p1_price,
                      fibColor, 1.0f, false);

    // 5. FibConfig otomatis di-set oleh GlobalShapeManager constructor
    //    (sudah ada level 0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, 1.618)

    printf("[JarvisDraw] FIB: Low(%d,%.2f) ‚Üí High(%d,%.2f)\n",
           params.swing_low_index, params.swing_low_price,
           params.swing_high_index, params.swing_high_price);

    return true;
}

// ============================================================
// TOOL 3: chart_draw_elliott
// Menggambar Elliott Wave (multi-point: P0‚ÜíP1‚ÜíP2‚ÜíP3‚ÜíP4/P5)
// Elliot butuh minimal 5 titik, idealnya 6 (impulse + correction)
// ============================================================
struct JarvisElliottPoint {
    int candle_index;
    double price;
};

struct JarvisElliottParams {
    std::vector<JarvisElliottPoint> points;
};

static bool JarvisDrawElliott(const JarvisElliottParams& params) {
    // Minimal 3 titik untuk wave yang meaningful
    if (params.points.size() < 3) {
        printf("[JarvisDraw] ELLIOTT: Need at least 3 points, got %d\n",
               (int)params.points.size());
        return false;
    }

    // 1. Konversi semua titik: candle_index ‚Üí time
    std::vector<double> times;
    std::vector<double> prices;

    for (const auto& pt : params.points) {
        double t;
        if (!JarvisCandleIndexToTime(pt.candle_index, t)) {
            printf("[JarvisDraw] ELLIOTT: Failed to convert candle_index %d\n",
                   pt.candle_index);
            return false;
        }
        times.push_back(t);
        prices.push_back(pt.price);
    }

    // 2. Warna default Elliott (kuning/emas)
    ImVec4 ellColor = ImVec4(1.0f, 1.0f, 0.0f, 0.9f);

    // 3. Buat shape ELLIOT
    g_shapes.AddElliotShape(times, prices, ellColor);

    printf("[JarvisDraw] ELLIOTT: %d points drawn\n", (int)params.points.size());
    for (size_t i = 0; i < params.points.size(); i++) {
        printf("  P%zu: idx=%d price=%.2f\n", i, params.points[i].candle_index,
               params.points[i].price);
    }

    return true;
}

// ============================================================
// TOOL 4: chart_draw_ob ‚Äî Order Block Zone (RECT)
// Menggambar OB zone sebagai filled rectangle di chart
// Data diambil langsung dari SMC_Engine (BOS/CHOCH events)
// ============================================================
struct JarvisOBParams {
    std::string side    = "Bullish"; // Bullish | Bearish
    std::string kind    = "BOS";     // BOS | CHOCH
    double ob_low       = 0.0;      // batas bawah OB
    double ob_high      = 0.0;      // batas atas OB
    double ob_t0        = 0.0;      // unix time mulai OB
    double ob_t1        = 0.0;      // unix time akhir OB
    std::string label   = "";        // "OB Bull" / "OB Bear"
    bool extend_right   = true;      // perpanjang ke kanan (aktif)
};

static bool JarvisDrawOB(const JarvisOBParams& params) {
    // VALIDASI: OB zone harus punya range harga dan waktu
    if (std::abs(params.ob_high - params.ob_low) < 0.0001) {
        printf("[JarvisDraw] OB REJECTED: ob_high==ob_low (%.2f). No price range!\n", params.ob_low);
        return false;
    }
    if (params.ob_t0 == 0 || params.ob_t1 == 0) {
        printf("[JarvisDraw] OB REJECTED: ob_t0 or ob_t1 is zero!\n");
        return false;
    }

    // 1. Warna berdasarkan side
    bool isBullish = (params.side == "Bullish");
    ImVec4 borderColor = isBullish
        ? ImVec4(0.0f, 0.85f, 0.3f, 0.9f)   // hijau = bullish OB
        : ImVec4(0.9f, 0.2f, 0.2f, 0.9f);    // merah = bearish OB
    ImVec4 fillColor   = isBullish
        ? ImVec4(0.0f, 0.5f, 0.2f, 1.0f)     // hijau gelap fill
        : ImVec4(0.5f, 0.1f, 0.1f, 1.0f);    // merah gelap fill

    // 2. OB rectangle digambar dari t0 (OB candle) ke t1 (break candle)
    //    Extend right = visual extension ke candle terakhir (bukan override t1!)
    //    Ini mirip cara Python server: OB|Side|lo|hi|t0|t1 (presisi)
    //    Lalu EA MQ5 extend via UpdateOBExtendAndBreak()
    double effective_t1 = params.ob_t1;
    if (params.extend_right) {
        auto it = g_allCandles.find(g_activeTF);
        if (it != g_allCandles.end() && !it->second.empty()) {
            double lastCandleTime = it->second.back().time;
            // ‚îÄ‚îÄ BUG FIX: Saat replay, extend hanya sampai posisi replay ‚îÄ‚îÄ
            // Kalau extend ke candle terakhir (full data), OB akan melampaui
            // area visual replay. Extend ke replay position instead.
            if (g_replayMode && g_tfIndices.count(g_activeTF)) {
                int rpIdx = g_tfIndices[g_activeTF];
                if (rpIdx >= 0 && rpIdx < (int)it->second.size()) {
                    double replayTime = it->second[rpIdx].time;
                    if (replayTime > params.ob_t1) {
                        lastCandleTime = replayTime;
                    }
                }
            }
            // Hanya extend kalau candle terakhir LEBIH BARU dari ob_t1
            // Ini berarti OB masih aktif dan belum terlewat
            if (lastCandleTime > params.ob_t1) {
                effective_t1 = lastCandleTime;
            }
            // Jika ob_t1 sudah di/melebihi candle terakhir, biarkan original
        }
    }

    // 3. Buat RECT shape ‚Äî time0/price0 = top-left, time1/price1 = bottom-right
    //    GlobalShapeManager RECT: (time0,price0) = corner1, (time1,price1) = corner2
    g_shapes.AddShape("RECT", params.ob_t0, params.ob_high, effective_t1, params.ob_low,
                      borderColor, 1.2f, false);

    // 4. Set RECT properties
    auto& shapes = g_shapes.GetEditableShapes();
    if (!shapes.empty()) {
        auto& shape = shapes.back();
        shape.filled            = true;
        shape.fillColor         = fillColor;
        shape.fillOpacity       = 0.15f;    // transparan, biar candle tetap kelihatan
        shape.rectBorderVisible = true;
        shape.lineStyle         = 1;        // dashed border
        shape.extendRight       = params.extend_right;  // extend ke kanan (liquidity zone)
        shape.extendLeft        = false;

        // Label: "OB Bull BOS" atau "OB Bear CHOCH"
        if (!params.label.empty()) {
            shape.rectLabel    = params.label;
            shape.rectFontSize = 8.0f;
            shape.rectBold     = true;
            shape.rectVertAlign = 2; // bawah
        }
    }

    printf("[JarvisDraw] OB: %s %s zone(%.2f-%.2f) t0=%.0f t1=%.0f‚Üí%.0f extend=%s (LIQUIDITY ZONE)\n",
           params.side.c_str(), params.kind.c_str(),
           params.ob_low, params.ob_high,
           params.ob_t0, params.ob_t1, effective_t1,
           params.extend_right ? "R" : "none");

    return true;
}

// ============================================================
// TOOL 5: chart_draw_smc_bos ‚Äî BOS/CHOCH Structure Line
// Gambar garis horizontal di level break dengan label
// Warna otomatis: Bullish=hijau, Bearish=merah, CHOCH=biru
// ============================================================
struct JarvisSMCBOSParams {
    int    swing_idx  = 0;     // candle index pivot swing
    int    break_idx  = 0;     // candle index break
    double level      = 0.0;   // harga level yang di-break
    std::string kind  = "BOS"; // "BOS" or "CHOCH"
    std::string side  = "Bullish"; // "Bullish" or "Bearish"
    std::string extend = "right"; // none | right | both ‚Äî AI tentukan berdasarkan konteks
    std::string description = ""; // Penjelasan: "Break struktur bullish, lanjut naik"
    double t_swing    = 0.0;   // unix time swing (langsung, tanpa candle index lookup)
    double t_break    = 0.0;   // unix time break (langsung, tanpa candle index lookup)
};

static bool JarvisDrawSMCBOS(const JarvisSMCBOSParams& params) {
    // VALIDASI
    if (params.swing_idx == params.break_idx && params.level == 0.0
        && params.t_swing == 0 && params.t_break == 0) {
        printf("[JarvisDraw] SMC-BOS REJECTED: swing_idx==break_idx dan level=0 dan t_swing/t_break=0\n");
        return false;
    }

    // 1. Konversi ke time ‚Äî PRIORITAS: t_swing/t_break (langsung dari SMC engine)
    //    Fallback: candle_index ‚Üí time lookup
    double time0, time1;
    if (params.t_swing > 0 && params.t_break > 0) {
        // Langsung pakai timestamp dari SMC engine (PRESISI!)
        time0 = params.t_swing;
        time1 = params.t_break;
    } else {
        // Fallback: candle index lookup
        if (!JarvisCandleIndexToTime(params.swing_idx, time0)) return false;
        if (!JarvisCandleIndexToTime(params.break_idx, time1)) return false;
    }

    // 2. Warna berdasarkan kind + side
    ImVec4 col;
    if (params.kind == "CHOCH") {
        col = ImVec4(0.2f, 0.5f, 1.0f, 1.0f);     // biru = CHOCH (perubahan struktur)
    } else if (params.side == "Bullish") {
        col = ImVec4(0.0f, 0.85f, 0.3f, 1.0f);     // hijau = BOS Bullish
    } else {
        col = ImVec4(0.9f, 0.2f, 0.2f, 1.0f);      // merah = BOS Bearish
    }

    // 3. Gambar LINE horizontal di level (dashed, extend sesuai parameter)
    g_shapes.AddShape("LINE", time0, params.level, time1, params.level,
                      col, 1.5f, false);

    // 4. Set properties ‚Äî extend bisa diatur AI, default right
    std::string ext = params.extend;
    for (auto& ch : ext) ch = std::tolower(ch);

    auto& shapes = g_shapes.GetEditableShapes();
    if (!shapes.empty()) {
        auto& shape = shapes.back();
        shape.lineStyle   = 1;          // dashed
        shape.extendLeft  = (ext == "left" || ext == "both");
        shape.extendRight = (ext == "right" || ext == "both" || ext.empty());
    }

    // 5. Tambah label ‚Äî lebih deskriptif dengan description + price tag
    //    Format: "BOS Bullish - Break struktur bullish $67500.00"
    //    Atau kalau ada description: "BOS Bullish - Break struktur bullish, lanjut naik $67500.00"
    std::string label = params.kind + " " + params.side;
    if (!params.description.empty()) {
        label += " - " + params.description;
    }
    // Auto-append price
    char priceBuf[32];
    snprintf(priceBuf, sizeof(priceBuf), " $%.2f", params.level);
    label += priceBuf;

    GlobalShape textShape;
    textShape.id          = g_shapes.GenerateUUID();
    textShape.type        = "TEXT";
    textShape.time0       = time1;     // label di titik break
    textShape.price0      = params.level;
    textShape.textContent = label;
    textShape.color       = col;
    textShape.fontSize    = 11.0f;
    textShape.textBg      = true;
    textShape.textBgColor = ImVec4(0.0f, 0.0f, 0.0f, 0.8f);
    g_shapes.AddShape(textShape);

    printf("[JarvisDraw] SMC-BOS: %s %s @%.2f sw:%d‚Üíbr:%d extend=%s desc=\"%s\"\n",
           params.kind.c_str(), params.side.c_str(), params.level,
           params.swing_idx, params.break_idx, params.extend.c_str(),
           params.description.c_str());

    return true;
}

// ============================================================
// TOOL 7: chart_draw_hline ‚Äî Horizontal Line (Pure Price)
// SARAF MESIN LEVEL 1: AI sebut harga ‚Üí mesin gambar garis
//
// TIDAK butuh candle_index, TIDAK butuh timestamp lookup!
// Cuma butuh: price (harga) + style + color + label
// Garis horizontal dari "candle sekarang" ke kanan (ala TradingView)
//
// Isyarat format:
//   #entry 81137  ‚Üí garis dashed emas (entry level)
//   #SL 81350     ‚Üí garis dotted merah (stop loss)
//   #TP 79400     ‚Üí garis dotted hijau (take profit)
// ============================================================
struct JarvisHLineParams {
    double price     = 0.0;       // Harga ‚Äî ini SATU-SATUNYA data wajib!
    std::string style = "dashed"; // solid | dashed | dotted
    std::string color = "gold";   // gold (entry) | red (SL) | lime (TP) | auto
    float thickness  = 2.0f;
    std::string label = "";       // "ENTRY 81137", "SL 81350", "TP 79400"
};

static bool JarvisDrawHLine(const JarvisHLineParams& params) {
    if (params.price <= 0.0) {
        printf("[JarvisDraw] HLINE REJECTED: price <= 0 (%.2f)\n", params.price);
        return false;
    }

    // 1. Cari candle terakhir untuk posisi awal garis
    auto it = g_allCandles.find(g_activeTF);
    if (it == g_allCandles.end() || it->second.empty()) {
        printf("[JarvisDraw] HLINE REJECTED: No candle data for TF %s\n", g_activeTF.c_str());
        return false;
    }

    const auto& candles = it->second;

    // Mulai dari 20 candle sebelum terakhir (biar garis kelihatan)
    int startIdx = std::max(0, (int)candles.size() - 20);
    double time0 = candles[startIdx].time;
    // Berakhir di candle terakhir
    double time1 = candles.back().time;

    // 2. Warna
    ImVec4 col = JarvisParseColor(params.color);

    // 3. Buat shape LINE horizontal (harga sama di kedua titik)
    g_shapes.AddShape("LINE", time0, params.price, time1, params.price,
                      col, params.thickness, false);

    // 4. Set properties ‚Äî extend right (garis lanjut ke kanan chart)
    auto& shapes = g_shapes.GetEditableShapes();
    if (!shapes.empty()) {
        auto& shape = shapes.back();
        // Style: 0=solid, 1=dashed, 2=dotted
        shape.lineStyle   = JarvisParseLineStyle(params.style);
        shape.extendRight = true;   // Selalu extend ke kanan (ala TradingView)
        shape.extendLeft  = false;  // Tidak extend ke kiri
    }

    // 5. Tambah label teks di ujung kanan garis
    if (!params.label.empty()) {
        GlobalShape textShape;
        textShape.id          = g_shapes.GenerateUUID();
        textShape.type        = "TEXT";
        textShape.time0       = time1;     // label di candle terakhir
        textShape.price0      = params.price;
        textShape.textContent = params.label;
        textShape.color       = col;
        textShape.fontSize    = 12.0f;
        textShape.textBg      = true;
        textShape.textBgColor = ImVec4(0.0f, 0.0f, 0.0f, 0.85f);
        g_shapes.AddShape(textShape);
    }

    printf("[JarvisDraw] HLINE: %s @%.2f style=%s color=%s\n",
           params.label.c_str(), params.price,
           params.style.c_str(), params.color.c_str());

    return true;
}

// ============================================================
// BULK RENDER ‚Äî Dipanggil dari jarvis_on_response
// Menerima JSON array of draw actions dari server
// ============================================================
static void JarvisExecuteDrawActions(const json& actions) {
    if (!actions.is_array()) return;

    int drawnCount = 0;

    for (const auto& action : actions) {
        std::string toolName = action.value("tool", "");
        json args = action.value("arguments", json::object());
        json result = action.value("result", json::object());
        bool success = result.value("success", false);

        if (!success) continue;

        // ‚îÄ‚îÄ chart_draw_line ‚îÄ‚îÄ
        if (toolName == "chart_draw_line") {
            JarvisLineParams p;
            p.style           = args.value("style", "dotted");
            p.extend          = args.value("extend", "right");
            p.p0_candle_index = args.value("p0_candle_index", 0);
            p.p0_price        = args.value("p0_price", 0.0);
            p.p1_candle_index = args.value("p1_candle_index", 0);
            p.p1_price        = args.value("p1_price", 0.0);
            p.label           = args.value("label", "");
            p.color           = args.value("color", "auto");
            p.thickness       = (float)args.value("thickness", 1.2);
            p.description     = args.value("description", "");
            p.showPriceTag    = args.value("show_price_tag", true);

            if (JarvisDrawLine(p)) drawnCount++;
        }

        // ‚îÄ‚îÄ chart_draw_fibonacci ‚îÄ‚îÄ
        else if (toolName == "chart_draw_fibonacci") {
            JarvisFibParams p;
            p.swing_low_index  = args.value("swing_low_index", 0);
            p.swing_low_price  = args.value("swing_low_price", 0.0);
            p.swing_high_index = args.value("swing_high_index", 0);
            p.swing_high_price = args.value("swing_high_price", 0.0);

            if (JarvisDrawFibonacci(p)) drawnCount++;
        }

        // ‚îÄ‚îÄ chart_draw_elliott ‚îÄ‚îÄ
        else if (toolName == "chart_draw_elliott") {
            JarvisElliottParams p;

            if (args.contains("points") && args["points"].is_array()) {
                for (const auto& pt : args["points"]) {
                    JarvisElliottPoint ep;
                    ep.candle_index = pt.value("candle_index", 0);
                    ep.price        = pt.value("price", 0.0);
                    p.points.push_back(ep);
                }
            }

            if (JarvisDrawElliott(p)) drawnCount++;
        }

        // ‚îÄ‚îÄ chart_draw_ob (Order Block zone) ‚îÄ‚îÄ
        else if (toolName == "chart_draw_ob") {
            JarvisOBParams p;
            p.side         = args.value("side", "Bullish");
            p.kind         = args.value("kind", "BOS");
            p.ob_low       = args.value("ob_low", 0.0);
            p.ob_high      = args.value("ob_high", 0.0);
            p.ob_t0        = args.value("ob_t0", 0.0);
            p.ob_t1        = args.value("ob_t1", 0.0);
            p.label        = args.value("label", "");
            p.extend_right = args.value("extend_right", true);  // default TRUE = liquidity zone

            if (JarvisDrawOB(p)) drawnCount++;
        }

        // ‚îÄ‚îÄ chart_draw_bos (BOS/CHOCH structure line) ‚îÄ‚îÄ
        else if (toolName == "chart_draw_bos") {
            JarvisSMCBOSParams p;
            p.swing_idx   = args.value("swing_idx", 0);
            p.break_idx   = args.value("break_idx", 0);
            p.level       = args.value("level", 0.0);
            p.kind        = args.value("kind", "BOS");
            p.side        = args.value("side", "Bullish");
            p.extend      = args.value("extend", "right");
            p.description = args.value("description", "");
            p.t_swing     = args.value("t_swing", 0.0);
            p.t_break     = args.value("t_break", 0.0);

            if (JarvisDrawSMCBOS(p)) drawnCount++;
        }

        // ‚îÄ‚îÄ chart_draw_hline (Horizontal Line ‚Äî pure price) ‚îÄ‚îÄ
        // SARAF MESIN LEVEL 1: AI sebut harga ‚Üí mesin gambar garis
        // TIDAK butuh candle_index, TIDAK butuh timestamp lookup
        else if (toolName == "chart_draw_hline") {
            JarvisHLineParams p;
            p.price     = args.value("price", 0.0);
            p.style     = args.value("style", "dashed");
            p.color     = args.value("color", "gold");
            p.thickness = (float)args.value("thickness", 2.0);
            p.label     = args.value("label", "");

            if (JarvisDrawHLine(p)) drawnCount++;
        }
    }

    printf("[JarvisDraw] Total shapes drawn: %d\n", drawnCount);
}

// ============================================================
// SMART SMC RENDER ‚Äî chart_draw_smc_all
// Re-scan dari data candle REAL, gambar SEMUA BOS/CHOCH + OB valid
// AI TIDAK perlu kirim koordinat ‚Äî C++ yang hitung semua!
// Dipanggil langsung dari JarvisBridge_DrawSMCAll() di main.cpp
//
// V12 (ExMachina): OB stored separately in ScanState::internalOBs/swingOBs.
//   BOS/CHoCH events drawn from ScanState::events.
//   OB zones drawn from SOrderBlock vectors (active only).
// ============================================================
static int JarvisDrawSMCAll(
    const SMCEngine::ScanState& state,
    const SMCEngine::Params& params,
    const std::vector<Candle>& candles)
{
    if (candles.empty()) {
        printf("[JarvisDraw] SMC-ALL: No candles to draw\n");
        return 0;
    }

    const auto& events = state.events;
    int drawnBOS = 0, drawnOB = 0, skippedOB = 0;

    // Simpan jumlah shape sebelum draw ‚Äî untuk track ID shapes SMC baru
    size_t shapeCountBefore = g_shapes.GetEditableShapes().size();

    // Helper: cari candle index dari unix timestamp
    auto findIdx = [&](double t) -> int {
        int lo = 0, hi = (int)candles.size() - 1;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            if (candles[mid].time < t)      lo = mid + 1;
            else if (candles[mid].time > t) hi = mid - 1;
            else return mid;
        }
        return lo;
    };

    // ‚îÄ‚îÄ Replay position: batas candle yang terlihat saat replay ‚îÄ‚îÄ
    // BUG FIX: Saat replay, SMC objects (BOS lines + OB zones) yang
    // berada di masa depan (barIndex > replayMaxIdx) TIDAK boleh digambar.
    // Ini mencegah "ghost OB" dan "future BOS" yang seharusnya belum ada.
    int replayMaxIdx = (int)candles.size() - 1;  // default: all candles visible
    if (g_replayMode && g_tfIndices.count(g_activeTF)) {
        replayMaxIdx = g_tfIndices[g_activeTF];
    }

    // ‚îÄ‚îÄ 1. Gambar BOS/CHOCH lines (last 8 events, hemat clutter) ‚îÄ‚îÄ
    //    BUG FIX: Saat replay, skip events yang break_candle_idx > replayMaxIdx.
    //    BOS di masa depan tidak boleh ditampilkan.
    int startI = std::max(0, (int)events.size() - 8);

    for (int i = startI; i < (int)events.size(); i++) {
        const auto& ev = events[i];

        // Skip future BOS events during replay
        int evBreakIdx = (ev.break_candle_idx >= 0) ? ev.break_candle_idx : findIdx(ev.t_break);
        if (evBreakIdx > replayMaxIdx) continue;

        int swIdx = (ev.swing_candle_idx >= 0) ? ev.swing_candle_idx : findIdx(ev.t_swing);
        int brIdx = (ev.break_candle_idx >= 0) ? ev.break_candle_idx : findIdx(ev.t_break);

        JarvisSMCBOSParams bosP;
        bosP.swing_idx = swIdx;
        bosP.break_idx = brIdx;
        bosP.level     = ev.level;
        bosP.kind      = ev.Kind();    // "BOS" or "CHOCH"
        bosP.side      = ev.Side();    // "Bullish" or "Bearish"

        if (JarvisDrawSMCBOS(bosP)) drawnBOS++;
    }

    // ‚îÄ‚îÄ 2. Gambar OB zones dari SOrderBlock vectors (V12 ExMachina) ‚îÄ‚îÄ
    //    ExMachina style: iterasi dari BELAKANG (OB terbaru dulu),
    //    limit maxCount (5 internal + 5 swing default).
    //    Ini cegah OB lama muncul tanpa BOS line yang visible.
    //
    //    BUG FIX: Saat replay, hanya gambar OB yang barIndex <= replayIdx.
    //    OB dari masa depan (belum terlihat) TIDAK boleh digambar.

    auto drawOBs = [&](const std::vector<SMCEngine::SOrderBlock>& obs,
                       const char* scope, int maxCount) {
        int drawn = 0;
        // ExMachina: iterate dari belakang (terbaru dulu), limit maxCount
        for (int j = (int)obs.size() - 1; j >= 0 && drawn < maxCount; j--) {
            const auto& ob = obs[j];
            if (!ob.active) {
                skippedOB++;
                continue;
            }
            if (ob.high <= ob.low) continue;  // degenerate zone

            // ‚îÄ‚îÄ BUG FIX: Skip OB yang barIndex > replayMaxIdx ‚îÄ‚îÄ
            // Saat replay, OB dari masa depan (belum terlihat) TIDAK digambar.
            // Ini mencegah "ghost OB" yang seharusnya belum ada di posisi replay.
            if (ob.barIndex > replayMaxIdx) {
                skippedOB++;
                continue;
            }

            JarvisOBParams obP;
            obP.side         = (ob.bias > 0) ? "Bullish" : "Bearish";
            obP.kind         = "OB";
            obP.ob_low       = ob.low;
            obP.ob_high      = ob.high;
            obP.ob_t0        = ob.barTime;
            obP.ob_t1        = ob.barTime;  // Will be extended to last candle by JarvisDrawOB
            obP.extend_right = true;

            // Label: "OB Bull Int #5" or "OB Bear Swing #3" ‚Äî with eventId for tracing
            char labelBuf[80];
            if (ob.eventId >= 0) {
                snprintf(labelBuf, sizeof(labelBuf), "OB %s %s #%d",
                         (ob.bias > 0 ? "Bull" : "Bear"), scope, ob.eventId);
            } else {
                snprintf(labelBuf, sizeof(labelBuf), "OB %s %s",
                         (ob.bias > 0 ? "Bull" : "Bear"), scope);
            }
            obP.label = labelBuf;

            if (JarvisDrawOB(obP)) { drawnOB++; drawn++; }
        }
    };

    // ExMachina: limit OB count per scope (InpInternalOBCount=5, InpSwingOBCount=5)
    if (params.show_internal_ob) {
        drawOBs(state.internalOBs, "Int", params.internal_ob_count);
    }
    if (params.show_swing_ob) {
        drawOBs(state.swingOBs, "Swing", params.swing_ob_count);
    }

    printf("[JarvisDraw] SMC-ALL DONE: %d BOS lines + %d OB zones (skipped %d mitigated) | events %d-%d/%d | OB limit Int=%d Swing=%d\n",
           drawnBOS, drawnOB, skippedOB, startI, (int)events.size()-1, (int)events.size(),
           params.internal_ob_count, params.swing_ob_count);

    // ‚îÄ‚îÄ 3. Track ID shapes SMC yang baru digambar ‚îÄ‚îÄ
    //    Supaya next redraw bisa hapus by ID (cegah OB duplicate saat replay/rescan)
    JarvisSMCTrackNewShapes(shapeCountBefore);

    return drawnBOS + drawnOB;
}
// ============================================================
//  JarvisSemanticEngine.h ‚Äî Semantic AI Engine v6: EVOLUTION + INCREMENTAL
//
//  UPDATE v6 (EVOLUTION + INCREMENTAL UPDATE):
//  - Evolution: OB yang body-break bisa evolve jadi CHoCH
//  - Incremental: Tidak lagi clear() semua saat update
//  - Dual Validation: OB status 4 level (valid/touch/wickbreak/bodybreak)
//  - Render Terbalik: CHoCH muncul saat confirmed, OB hilang saat invalidated
//
//  PERUBAHAN DARI v5:
//  v5: OB dan BRK punya ID terpisah, tapi setiap update = clear() + re-register
//  v6: Incremental update ‚Äî register yang baru, update yang berubah, jangan clear!
//       OB yang BodyBreak ‚Üí evolve jadi CHoCH (render terbalik)
//
//  FORMAT OUTPUT generateCompactContext():
//    OB: #127=Bearish_81137_81271_T1778662800-1778668200 #128=Bullish_79090_79249_T...
//    BRK: #200=BOS_Bearish_80486_T1778657400_B1778668200 #201=CHOCH_Bullish_79500_T...
//    SWG: #10=SH_80486_T1778657400 #11=SL_80296_T1778662800 | PRICE:80350 HI:80600 LO:79800 TR:BEARISH
//
//  EVOLUTION FORMAT:
//    OB #12 yang BodyBreak ‚Üí ob_status = "bodybreak" (OB HAPUS dari drawing)
//                           ‚Üí CHoCH baru ter-register di BRK section
//                           ‚Üí evolution_from_id = 12 (link ke OB asal)
//
//  ISYARAT FORMAT (AI output):
//    #127 OB Bearish: 81137->81271    ‚Üí rectangle (zona)
//    #200 BOS Bearish: 80486          ‚Üí line (garis break)
//    #201 CHOCH Bullish: 79500        ‚Üí line (garis change)
//    #10 SH: 80486                    ‚Üí dot (swing high)
//
//  PRINSIP: OBJ string hanya LABEL untuk LLM reference.
//           Data positioning lengkap HANYA ada di EnvObject.
//           Rendering SELALU lookup EnvObject, bukan parse OBJ.
// ============================================================

#pragma once
#include <string>
#include <map>
#include <vector>
#include <sstream>
#include <cmath>
#include <algorithm>

// ============================================================
//  EvolutionRecord ‚Äî Track OB ‚Üí CHoCH transformation
// ============================================================
struct EvolutionRecord {
    int    original_ob_id = 0;      // ID OB asli di EnvironmentMemory
    std::string original_type;       // "OBB" / "OBS"
    std::string original_side;      // "Bearish" / "Bullish"
    float  original_zone_low = 0;
    float  original_zone_high = 0;
    int    evolved_choch_id = 0;    // ID CHoCH baru di EnvironmentMemory
    std::string evolved_side;       // "Bullish" / "Bearish" (kebalikan OB)
    float  evolved_level = 0;       // level harga CHoCH
    long   evolution_time = 0;      // kapan terjadi bodybreak
    bool   registered = false;      // sudah ter-register di EnvironmentMemory?
};

// ============================================================
//  EnvObject ‚Äî Satu object di environment chart (v6)
// ============================================================
struct EnvObject {
    int id = 0;                  // #1, #2, #3 ...
    std::string type;            // "SH","SL","OBB","OBS","BOS","CHOCH","FVG","C"
    std::string kind;            // "BOS" / "CHOCH" (untuk break events, sama dgn type)
    std::string side;            // "Bearish" / "Bullish" (v5: eksplisit side field)
    std::string ob_status;       // "valid" / "touch" / "wickbreak" / "bodybreak" ‚Äî status OB dari SMC Engine
    float price = 0;             // main price (swing price / break level)
    float zone_low = 0;          // OB low / FVG bottom
    float zone_high = 0;         // OB high / FVG top
    int candle_index = 0;        // posisi swing di chart (swing candle index)
    int break_idx = 0;           // posisi break di chart (break candle index)
    float level = 0;             // harga level yang di-break (untuk BOS/CHOCH)
    float open = 0, high = 0, low = 0, close = 0;
    long timestamp = 0;          // start timestamp (ob_t0 / swing time)
    long timestamp_end = 0;      // end timestamp (ob_t1)
    long t_swing = 0;            // unix time pivot swing (khusus BOS/CHOCH)
    long t_break = 0;            // unix time candle break (khusus BOS/CHOCH)

    // V6: Evolution tracking
    int  evolution_from_id = 0;       // ID OB asal (kalau CHoCH lahir dari OB break)
    bool is_evolved = false;          // true = ini CHoCH yang lahir dari OB evolution
    bool ob_drawable = true;          // V6: OB hanya drawable kalau belum bodybreak

    // Derived helpers
    float getCenterPrice() const { return (zone_high + zone_low) / 2.0f; }
    bool isBearish() const { return type == "OBB" || side == "Bearish"; }
    bool isBullish() const { return type == "OBS" || side == "Bullish"; }
    bool isSwingHigh() const { return type == "SH"; }
    bool isSwingLow() const { return type == "SL"; }
    bool isOrderBlock() const { return type == "OBB" || type == "OBS"; }
    bool isBreakEvent() const { return type == "BOS" || type == "CHOCH"; }

    // V6: OB status helpers ‚Äî 4 level
    bool isOBValid() const { return ob_status == "valid" || ob_status.empty(); }
    bool isOBBroken() const { return ob_status == "bodybreak"; }  // V6: hanya bodybreak = broken
    bool isOBWickBreak() const { return ob_status == "wickbreak"; } // V6: wick break = masih hidup
    bool isOBTouched() const { return ob_status == "touch"; }

    // V6: Layak digambar? OB hanya kalau belum bodybreak
    bool isDrawable() const {
        if (isOrderBlock()) return ob_drawable && !isOBBroken();
        return true;  // BOS/CHOCH/FVG/swing selalu drawable
    }
};

// ============================================================
//  MarketState ‚Äî Current market snapshot
// ============================================================
struct MarketState {
    float current_price = 0;
    float highest_price = 0;
    float lowest_price = 999999;
    float daily_open = 0;
    int total_candles = 0;
    std::string symbol;
    std::string timeframe;
    std::string trend;
};

// ============================================================
//  EnvironmentMemory ‚Äî Spatial Memory Engine v6
//  KEY V6: Incremental update + Evolution support
// ============================================================
class EnvironmentMemory {
private:
    std::map<int, EnvObject> objects;
    int next_id = 1;
    MarketState market;
    int swing_high_count = 0;
    int swing_low_count = 0;
    int ob_count = 0;
    int break_count = 0;
    int fvg_count = 0;

    // V6: Evolution records ‚Äî track OB‚ÜíCHoCH transformations
    std::vector<EvolutionRecord> evolution_records;

    // V6: Track last registered candle count for incremental updates
    int last_candle_count = 0;

public:
    // V6: Full clear ‚Äî hanya dipanggil saat ganti symbol/timeframe
    void clear() {
        objects.clear();
        next_id = 1;
        swing_high_count = 0;
        swing_low_count = 0;
        ob_count = 0;
        break_count = 0;
        fvg_count = 0;
        evolution_records.clear();
        last_candle_count = 0;
    }

    // V6: Soft reset ‚Äî hanya reset counter, keep objects untuk incremental
    void softReset() {
        // Jangan clear objects! Hanya reset counter untuk re-registration
        swing_high_count = 0;
        swing_low_count = 0;
        ob_count = 0;
        break_count = 0;
        fvg_count = 0;
    }

    void setMarketState(const MarketState& s) { market = s; }
    const MarketState& getMarketState() const { return market; }
    int getLastCandleCount() const { return last_candle_count; }
    void setLastCandleCount(int count) { last_candle_count = count; }

    // ===== REGISTER: Simpan object baru, return ID =====

    int registerSwingHigh(float price, int candle_idx, long ts = 0) {
        // V6: Cek apakah swing high ini sudah ada (dedup by candle_idx + price)
        for (auto& [id, obj] : objects) {
            if (obj.type == "SH" && obj.candle_index == candle_idx
                && std::abs(obj.price - price) < 0.01f) {
                // Sudah ada, skip
                return obj.id;
            }
        }

        int id = next_id++;
        EnvObject obj;
        obj.id = id;
        obj.type = "SH";
        obj.price = price;
        obj.candle_index = candle_idx;
        obj.timestamp = ts;
        objects[id] = obj;
        swing_high_count++;
        return id;
    }

    int registerSwingLow(float price, int candle_idx, long ts = 0) {
        // V6: Cek apakah swing low ini sudah ada (dedup by candle_idx + price)
        for (auto& [id, obj] : objects) {
            if (obj.type == "SL" && obj.candle_index == candle_idx
                && std::abs(obj.price - price) < 0.01f) {
                // Sudah ada, skip
                return obj.id;
            }
        }

        int id = next_id++;
        EnvObject obj;
        obj.id = id;
        obj.type = "SL";
        obj.price = price;
        obj.candle_index = candle_idx;
        obj.timestamp = ts;
        objects[id] = obj;
        swing_low_count++;
        return id;
    }

    // v6: Register OB ‚Äî TANPA kind BOS/CHOCH! OB itu ZONA saja.
    //     AI gambar rectangle: #ID OB Side: low->high
    //     V6: Jika OB sudah ada (same zone), update status saja
    int registerOrderBlock(bool bullish, float low, float high,
                           int candle_idx, long t0 = 0, long t1 = 0,
                           int break_candle_idx = 0,
                           float broken_level = 0,
                           long ts_swing = 0, long ts_break = 0,
                           const std::string& status = "valid") {
        // V6: Cek apakah OB ini sudah ada (dedup by zone + direction)
        std::string targetType = bullish ? "OBS" : "OBB";
        for (auto& [id, obj] : objects) {
            if (obj.type == targetType
                && std::abs(obj.zone_low - low) < 0.01f
                && std::abs(obj.zone_high - high) < 0.01f) {
                // OB sudah ada! Update status saja (incremental!)
                obj.ob_status = status;
                obj.ob_drawable = (status != "bodybreak");
                return obj.id;
            }
        }

        // OB baru, register
        int id = next_id++;
        EnvObject obj;
        obj.id = id;
        obj.type = bullish ? "OBS" : "OBB";
        obj.side = bullish ? "Bullish" : "Bearish";
        obj.ob_status = status;  // "valid" / "touch" / "wickbreak" / "bodybreak"
        obj.price = (low + high) / 2.0f;
        obj.zone_low = low;
        obj.zone_high = high;
        obj.candle_index = candle_idx;
        obj.break_idx = break_candle_idx;
        obj.level = broken_level;
        obj.timestamp = t0;
        obj.timestamp_end = t1;  // ob_t1
        obj.t_swing = ts_swing;
        obj.t_break = ts_break;
        obj.ob_drawable = (status != "bodybreak");
        objects[id] = obj;
        ob_count++;
        return id;
    }

    // v6: Register BREAK EVENT ‚Äî BOS atau CHOCH (garis line)
    //     AI gambar garis: #ID BOS/CHOCH Side: level
    //     Terdaftar TERPISAH dari OB ‚Äî ID berbeda!
    //     V6: Jika break event sudah ada, skip (dedup)
    int registerBreakEvent(const std::string& kind,  // "BOS" or "CHOCH"
                           const std::string& side,   // "Bearish" or "Bullish"
                           float break_level,
                           int swing_candle_idx,
                           int break_candle_idx,
                           long ts_swing = 0,
                           long ts_break = 0,
                           int evolution_from_ob_id = 0) {  // V6: evolution tracking
        // V6: Dedup ‚Äî cek apakah break event ini sudah ada
        for (auto& [id, obj] : objects) {
            if ((obj.type == kind)
                && obj.side == side
                && std::abs(obj.level - break_level) < 0.01f
                && obj.candle_index == swing_candle_idx) {
                // Sudah ada, skip
                return obj.id;
            }
        }

        int id = next_id++;
        EnvObject obj;
        obj.id = id;
        obj.type = kind;  // "BOS" or "CHOCH"
        obj.kind = kind;
        obj.side = side;
        obj.price = break_level;
        obj.level = break_level;
        obj.candle_index = swing_candle_idx;
        obj.break_idx = break_candle_idx;
        obj.t_swing = ts_swing;
        obj.t_break = ts_break;
        // V6: Evolution tracking
        obj.evolution_from_id = evolution_from_ob_id;
        obj.is_evolved = (evolution_from_ob_id > 0);
        objects[id] = obj;
        break_count++;
        return id;
    }

    int registerFVG(float top, float mid, float bot, int candle_idx,
                    long t0 = 0, long t1 = 0) {
        int id = next_id++;
        EnvObject obj;
        obj.id = id;
        obj.type = "FVG";
        obj.price = mid;
        obj.zone_low = bot;
        obj.zone_high = top;
        obj.candle_index = candle_idx;
        obj.timestamp = t0;
        obj.timestamp_end = t1;
        objects[id] = obj;
        fvg_count++;
        return id;
    }

    int registerCandle(int idx, float o, float h, float l, float c, long ts = 0) {
        // V6: Dedup ‚Äî cek apakah candle ini sudah ada
        for (auto& [id, obj] : objects) {
            if (obj.type == "C" && obj.candle_index == idx) {
                // Update candle data (forming candle bisa berubah)
                obj.open = o; obj.high = h; obj.low = l; obj.close = c;
                obj.price = c;
                obj.zone_low = l;
                obj.zone_high = h;
                return obj.id;
            }
        }

        int id = next_id++;
        EnvObject obj;
        obj.id = id;
        obj.type = "C";
        obj.price = c;
        obj.zone_low = l;
        obj.zone_high = h;
        obj.candle_index = idx;
        obj.open = o; obj.high = h; obj.low = l; obj.close = c;
        obj.timestamp = ts;
        objects[id] = obj;
        return id;
    }

    // ===== V6: EVOLUTION ‚Äî OB BodyBreak ‚Üí CHoCH =====
    //
    // Dipanggil saat OB detected sebagai BodyBreak oleh UpdateOBStatus().
    // 1. Update OB: ob_status = "bodybreak", ob_drawable = false (HAPUS dari drawing)
    // 2. Register CHoCH baru: garis line di level OB (GAMBAR garis CHoCH)
    // 3. Simpan evolution record untuk audit trail
    //
    // RENDER TERBALIK:
    //   OB BodyBreak ‚Üí OB HAPUS, CHoCH GAMBAR
    int evolveOBtoCHoCH(int ob_id, float choch_level, const std::string& choch_side,
                        int swing_candle_idx, int break_candle_idx,
                        long ts_swing = 0, long ts_break = 0) {
        auto it = objects.find(ob_id);
        if (it == objects.end()) return -1;  // OB tidak ditemukan

        EnvObject& ob = it->second;

        // 1. OB ‚Üí HAPUS dari drawing
        ob.ob_status = "bodybreak";
        ob.ob_drawable = false;

        // 2. CHoCH ‚Üí GAMBAR garis baru
        int choch_id = registerBreakEvent(
            "CHOCH", choch_side, choch_level,
            swing_candle_idx, break_candle_idx,
            ts_swing, ts_break,
            ob_id  // evolution_from_id
        );

        // 3. Simpan evolution record
        EvolutionRecord rec;
        rec.original_ob_id = ob_id;
        rec.original_type = ob.type;
        rec.original_side = ob.side;
        rec.original_zone_low = ob.zone_low;
        rec.original_zone_high = ob.zone_high;
        rec.evolved_choch_id = choch_id;
        rec.evolved_side = choch_side;
        rec.evolved_level = choch_level;
        rec.evolution_time = ts_break;
        rec.registered = true;
        evolution_records.push_back(rec);

        printf("[SEMANTIC] EVOLUTION: OB #%d %s ‚Üí CHoCH #%d %s @ %.2f\n",
               ob_id, ob.side.c_str(), choch_id, choch_side.c_str(), choch_level);

        return choch_id;
    }

    // ===== V6: UPDATE OB STATUS (incremental) =====
    // Update status OB yang sudah terdaftar tanpa re-register
    void updateOBStatus(int ob_id, const std::string& new_status) {
        auto it = objects.find(ob_id);
        if (it == objects.end()) return;

        it->second.ob_status = new_status;
        it->second.ob_drawable = (new_status != "bodybreak");
    }

    // ===== RESOLVE: Cari object by ID =====
    EnvObject* resolve(int id) {
        auto it = objects.find(id);
        if (it != objects.end()) return &it->second;
        return nullptr;
    }

    // ===== FIND: Cari object by criteria =====

    EnvObject* findNearestSwingHigh(float near_price, float tolerance_pct = 0.5f) {
        EnvObject* best = nullptr;
        float best_dist = near_price * (tolerance_pct / 100.0f);
        for (auto& [id, obj] : objects) {
            if (obj.type == "SH") {
                float dist = std::abs(obj.price - near_price);
                if (dist < best_dist) {
                    best_dist = dist;
                    best = &obj;
                }
            }
        }
        return best;
    }

    EnvObject* findNearestSwingLow(float near_price, float tolerance_pct = 0.5f) {
        EnvObject* best = nullptr;
        float best_dist = near_price * (tolerance_pct / 100.0f);
        for (auto& [id, obj] : objects) {
            if (obj.type == "SL") {
                float dist = std::abs(obj.price - near_price);
                if (dist < best_dist) {
                    best_dist = dist;
                    best = &obj;
                }
            }
        }
        return best;
    }

    EnvObject* findOBContainingPrice(float price) {
        for (auto& [id, obj] : objects) {
            if (obj.isOrderBlock() && obj.isDrawable()) {
                if (price >= obj.zone_low && price <= obj.zone_high) {
                    return &obj;
                }
            }
        }
        return nullptr;
    }

    // V6: Cari OB by zone matching (untuk incremental status update)
    EnvObject* findOBByZone(bool bullish, float low, float high) {
        std::string targetType = bullish ? "OBS" : "OBB";
        for (auto& [id, obj] : objects) {
            if (obj.type == targetType
                && std::abs(obj.zone_low - low) < 0.01f
                && std::abs(obj.zone_high - high) < 0.01f) {
                return &obj;
            }
        }
        return nullptr;
    }

    // V6: Cari OB yang belum di-evolve tapi sudah bodybreak
    //     Return list OB yang perlu di-evolve jadi CHoCH
    std::vector<EnvObject*> findOBsNeedingEvolution() {
        std::vector<EnvObject*> result;
        for (auto& [id, obj] : objects) {
            if (obj.isOrderBlock() && obj.ob_status == "bodybreak" && obj.ob_drawable == false) {
                // Cek apakah sudah ada evolution record untuk OB ini
                bool already_evolved = false;
                for (const auto& rec : evolution_records) {
                    if (rec.original_ob_id == id) {
                        already_evolved = true;
                        break;
                    }
                }
                if (!already_evolved) {
                    result.push_back(&obj);
                }
            }
        }
        return result;
    }

    std::vector<EnvObject*> getLastOfType(const std::string& type, int count) {
        std::vector<EnvObject*> result;
        for (auto it = objects.rbegin(); it != objects.rend() && (int)result.size() < count; ++it) {
            if (it->second.type == type) {
                result.push_back(&it->second);
            }
        }
        return result;
    }

    int getObjectCount() const { return (int)objects.size(); }
    int getSwingHighCount() const { return swing_high_count; }
    int getSwingLowCount() const { return swing_low_count; }
    int getOBCount() const { return ob_count; }
    int getBreakCount() const { return break_count; }
    const std::vector<EvolutionRecord>& getEvolutionRecords() const { return evolution_records; }

    // Debug map access
    const std::map<int, EnvObject>& getDebugMap() const { return objects; }

    // ===== GENERATE COMPACT CONTEXT v6 ‚Äî EVOLUTION + INCREMENTAL =====
    //
    // OB:  Hanya yang drawable (belum bodybreak)
    //      #127=Bearish_81137_81271_T1778662800-1778668200  (zona, valid only)
    // BRK: SEMUA BOS/CHOCH + CHoCH yang lahir dari evolution
    //      #200=BOS_Bearish_80486_T1778657400_B1778668200
    //      #250=CHOCH_Bullish_79500_T1778660000_B1778668200_E#127  (evolved from OB #127)
    // SWG: Swing pivot points
    //
    std::string generateCompactContext() const {
        std::string obSection = "OB: ";
        std::string brkSection = "BRK: ";
        std::string swgSection = "SWG: ";
        int obCount = 0, brkCount = 0, swgCount = 0;

        // ‚îÄ‚îÄ Section 1: OB ‚Äî ZONA ONLY, drawable only (belum bodybreak), NO kind ‚îÄ‚îÄ
        for (auto& [id, obj] : objects) {
            if (!obj.isOrderBlock()) continue;
            if (!obj.isDrawable()) continue;  // V6: OB bodybreak = HAPUS dari context

            std::string side = obj.side.empty()
                ? (obj.isBearish() ? std::string("Bearish") : std::string("Bullish"))
                : obj.side;
            // v6: NO kind! OB is just a ZONA.
            obSection += "#" + std::to_string(id) + "=" + side;
            obSection += "_" + formatPrice(obj.zone_low) + "_" + formatPrice(obj.zone_high);
            if (obj.timestamp > 0) {
                obSection += "_T" + std::to_string(obj.timestamp);
                if (obj.timestamp_end > 0) {
                    obSection += "-" + std::to_string(obj.timestamp_end);
                }
            }
            if (obj.t_swing > 0) {
                obSection += "_S" + std::to_string(obj.t_swing);
            }
            if (obj.t_break > 0) {
                obSection += "-B" + std::to_string(obj.t_break);
            }
            // V6: Tampilkan status OB (valid/touch/wickbreak)
            if (obj.ob_status != "valid" && !obj.ob_status.empty()) {
                obSection += "_" + obj.ob_status;
            }
            obSection += " ";
            obCount++;
        }

        // ‚îÄ‚îÄ Section 2: BRK ‚Äî BOS/CHOCH garis, SEMUA events + evolved CHoCH ‚îÄ‚îÄ
        for (auto& [id, obj] : objects) {
            if (!obj.isBreakEvent()) continue;

            std::string kind = obj.type;  // "BOS" or "CHOCH"
            std::string side = obj.side;
            float levelPrice = (obj.level > 0) ? obj.level : obj.price;

            brkSection += "#" + std::to_string(id) + "=" + kind + "_" + side;
            brkSection += "_" + formatPrice(levelPrice);
            if (obj.t_swing > 0) {
                brkSection += "_T" + std::to_string(obj.t_swing);
            }
            if (obj.t_break > 0) {
                brkSection += "_B" + std::to_string(obj.t_break);
            }
            // V6: Evolution tag ‚Äî CHoCH yang lahir dari OB
            if (obj.is_evolved && obj.evolution_from_id > 0) {
                brkSection += "_E#" + std::to_string(obj.evolution_from_id);
            }
            brkSection += " ";
            brkCount++;
        }

        // ‚îÄ‚îÄ Section 3: SWG ‚Äî Swing pivot points ‚îÄ‚îÄ
        // Kumpulkan semua swing secara kronologis untuk kalkulasi HH/HL/LH/LL
        std::vector<const EnvObject*> swings;
        for (auto& [id, obj] : objects) {
            if (obj.type == "SH" || obj.type == "SL") swings.push_back(&obj);
        }

        std::map<int, std::string> structLabels;
        float prevH = -1, prevL = -1;
        for (const auto* obj : swings) {
            if (obj->type == "SH") {
                if (prevH < 0) structLabels[obj->id] = "H1";
                else structLabels[obj->id] = (obj->price > prevH) ? "HH" : "LH";
                prevH = obj->price;
            } else {
                if (prevL < 0) structLabels[obj->id] = "L1";
                else structLabels[obj->id] = (obj->price < prevL) ? "LL" : "HL";
                prevL = obj->price;
            }
        }

        int swingSlots = 12;
        for (auto it = objects.rbegin(); it != objects.rend() && swgCount < swingSlots; ++it) {
            const auto& obj = it->second;
            if (obj.type != "SH" && obj.type != "SL") continue;

            swgSection += "#" + std::to_string(obj.id) + "=" + structLabels[obj.id];
            swgSection += "_" + formatPrice(obj.price);
            if (obj.timestamp > 0) {
                swgSection += "_T" + std::to_string(obj.timestamp);
            }
            swgSection += " ";
            swgCount++;
        }

        // ‚îÄ‚îÄ Assemble ‚îÄ‚îÄ
        std::string ctx;
        if (obCount > 0) ctx += obSection + "\n";
        if (brkCount > 0) ctx += brkSection + "\n";
        if (swgCount > 0) ctx += swgSection + "\n";
        ctx += formatMarketState();

        return ctx;
    }

private:
    std::string formatMarketState() const {
        std::string ctx;
        if (market.current_price > 0) {
            ctx += "| PRICE:" + formatPrice(market.current_price);
            ctx += " HI:" + formatPrice(market.highest_price);
            ctx += " LO:" + formatPrice(market.lowest_price);
            ctx += " TR:" + market.trend;
        }
        return ctx;
    }

public:

    std::string generateCandleContext(int max_candles = 10) const {
        std::string ctx = "CND: ";
        int count = 0;

        std::vector<const EnvObject*> candles;
        for (auto& [id, obj] : objects) {
            if (obj.type == "C") candles.push_back(&obj);
        }

        std::sort(candles.begin(), candles.end(),
            [](const EnvObject* a, const EnvObject* b) { return a->candle_index < b->candle_index; });

        int start = std::max(0, (int)candles.size() - max_candles);
        for (int i = start; i < (int)candles.size(); i++) {
            auto& c = *candles[i];
            ctx += "#" + std::to_string(c.id) + "=C" + std::to_string(c.candle_index)
                 + "_" + formatPrice(c.open) + "_" + formatPrice(c.high)
                 + "_" + formatPrice(c.low) + "_" + formatPrice(c.close) + " ";
            count++;
        }

        return ctx;
    }

    bool isPriceInRange(float price) const {
        if (market.highest_price <= 0) return true;
        float margin = (market.highest_price - market.lowest_price) * 0.05f;
        return price >= (market.lowest_price - margin) && price <= (market.highest_price + margin);
    }

    bool isValidOB(float low, float high) const {
        return low < high && isPriceInRange(low) && isPriceInRange(high);
    }

private:
    static std::string formatPrice(float p) {
        char buf[32];
        if (p >= 10000) snprintf(buf, sizeof(buf), "%.0f", p);
        else if (p >= 100) snprintf(buf, sizeof(buf), "%.2f", p);
        else snprintf(buf, sizeof(buf), "%.4f", p);
        return std::string(buf);
    }
};
// ============================================================
//  JarvisSemanticParser.h ‚Äî Bahasa Isyarat Parser v3
//
//  v5 UPDATE: OB isyarat TANPA kind BOS/CHOCH
//  - OB: #ID OB Side: low->high  (TANPA BOS/CHOCH!)
//  - BOS: #ID BOS Side: level    (garis line)
//  - CHOCH: #ID CHOCH Side: level (garis line)
//  - Backward compatible: #ID OB Side BOS/CHOCH: low->high masih diterima
//
//  FORMAT BAHASA ISYARAT v3:
//  ‚îå‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î¨‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î¨‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îê
//  ‚îÇ Tipe     ‚îÇ Format Isyarat                    ‚îÇ Contoh                         ‚îÇ
//  ‚îú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îº‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îº‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î§
//  ‚îÇ OB       ‚îÇ #ID OB Side: low‚Üíhigh             ‚îÇ #127 OB Bearish: 81137->81271 ‚îÇ
//  ‚îÇ BOS      ‚îÇ #ID BOS Side: level               ‚îÇ #200 BOS Bearish: 80486       ‚îÇ
//  ‚îÇ CHOCH    ‚îÇ #ID CHOCH Side: level             ‚îÇ #201 CHOCH Bullish: 79500     ‚îÇ
//  ‚îÇ FVG      ‚îÇ #ID FVG Side: top~mid~bot         ‚îÇ #5 FVG Bearish: 80486~80350~80296‚îÇ
//  ‚îÇ Entry    ‚îÇ #ID Entry Buy/Sell: price          ‚îÇ #3 Entry Sell: 80296          ‚îÇ
//  ‚îÇ SL       ‚îÇ #ID SL: price                      ‚îÇ #3 SL: 80600                  ‚îÇ
//  ‚îÇ TP       ‚îÇ #ID TP: price                      ‚îÇ #3 TP: 79800                  ‚îÇ
//  ‚îÇ Line     ‚îÇ #ID Line: price1‚Üíprice2            ‚îÇ #1 Line: 80486‚Üí80296          ‚îÇ
//  ‚îî‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î¥‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î¥‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îò
//
//  VISUAL MAPPING:
//  - OB   ‚Üí chart_draw_ob()   ‚Üí Rectangle (zona supply/demand)
//  - BOS  ‚Üí chart_draw_bos()  ‚Üí Line (garis break of structure)
//  - CHOCH‚Üí chart_draw_bos()  ‚Üí Line (garis change of character)
//  - FVG  ‚Üí chart_draw_ob()   ‚Üí Rectangle (zona fair value gap)
//  - Entry‚Üí chart_draw_line() ‚Üí Garis horizontal
//  - SL/TP‚Üí chart_draw_line() ‚Üí Garis dotted
// ============================================================

#pragma once
#include "JarvisSemanticEngine.h"
#include <vector>
#include <sstream>
#include <algorithm>
#include <regex>
#include <cstdio>

// ============================================================
//  IsyaratCommand ‚Äî Hasil parsing satu bahasa isyarat
// ============================================================
struct IsyaratCommand {
    int ref_id = 0;                    // #3 ‚Üí 3
    std::string type;                  // "ob", "bos", "choch", "fvg", "entry", "sl", "tp", "line"
    std::string side;                  // "Bearish" / "Bullish"
    std::string kind;                  // "BOS" / "CHOCH" (optional untuk OB, v5)
    std::string direction;             // "Buy" / "Sell" (untuk Entry)
    float low = 0;                     // OB low / price1
    float high = 0;                    // OB high / price2
    float level = 0;                   // BOS/CHOCH level
    float top = 0, mid = 0, bot = 0;  // FVG levels
    float price = 0;                   // SL/TP/Entry price
    long t0 = 0, t1 = 0;             // Timestamps (dari ENV-CTX lookup)
    std::string raw;                   // original text
    bool valid = false;
    std::string error;

    std::string toolStr;
    std::string toolJson;
};

// ============================================================
//  ToolExecutionResult ‚Äî Hasil eksekusi [TOOL] command
// ============================================================
struct ToolExecutionResult {
    bool success = false;
    std::string tool_name;
    std::string tool_args_json;
    std::string full_tool_str;
    std::string status_code;
    std::string message;
    int objects_drawn = 0;
    std::string command_raw;
};

// ============================================================
//  IsyaratParser ‚Äî Scanner + Parser + Translator + Executor
// ============================================================
class IsyaratParser {
private:
    EnvironmentMemory& env;

public:
    IsyaratParser(EnvironmentMemory& e) : env(e) {}

    // ============================================================
    //  MAIN: Scan seluruh teks dari LLM dashboard output
    // ============================================================
    std::vector<ToolExecutionResult> scanAndExecute(const std::string& llm_output) {
        std::vector<ToolExecutionResult> results;
        std::istringstream stream(llm_output);
        std::string line;

        while (std::getline(stream, line)) {
            line = trim(line);
            if (line.empty()) continue;

            IsyaratCommand cmd = parseIsyaratLine(line);
            if (!cmd.valid && cmd.type.empty()) continue;

            if (!cmd.valid) {
                ToolExecutionResult err;
                err.success = false;
                err.status_code = "$ERR_INVALID";
                err.message = cmd.error;
                err.command_raw = cmd.raw;
                results.push_back(err);
                continue;
            }

            ToolExecutionResult toolResult = translateToTool(cmd);
            results.push_back(toolResult);
        }

        return results;
    }

    std::vector<IsyaratCommand> scanOnly(const std::string& llm_output) {
        std::vector<IsyaratCommand> commands;
        std::istringstream stream(llm_output);
        std::string line;

        while (std::getline(stream, line)) {
            line = trim(line);
            if (line.empty()) continue;

            IsyaratCommand cmd = parseIsyaratLine(line);
            if (!cmd.type.empty()) {
                commands.push_back(cmd);
            }
        }

        return commands;
    }

    // ============================================================
    //  PARSE: "#127 OB Bearish: 81137->81271" ‚Üí IsyaratCommand
    //  v5: OB TANPA kind BOS/CHOCH. Tapi backward compatible.
    // ============================================================
    IsyaratCommand parseIsyaratLine(const std::string& line) {
        IsyaratCommand cmd;
        cmd.raw = line;

        // ‚îÄ‚îÄ OB v5 (PREFERRED): #ID OB Side: low‚Üíhigh ‚îÄ‚îÄ
        // Contoh: #127 OB Bearish: 81137->81271
        {
            std::regex re("#(\\d+)\\s+OB\\s+(Bearish|Bullish):\\s*([\\d.]+)\\s*(‚Üí|->)\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "ob";
                cmd.side = m[2].str();
                cmd.kind = "";  // v5: TIDAK ADA kind! OB itu zona saja.
                cmd.low = std::stof(m[3].str());
                cmd.high = std::stof(m[5].str());
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ OB v4 (BACKWARD): #ID OB Side Kind: low‚Üíhigh ‚îÄ‚îÄ
        // Contoh: #127 OB Bearish BOS: 81137->81271
        // MASIH diterima untuk backward compatibility
        {
            std::regex re("#(\\d+)\\s+OB\\s+(Bearish|Bullish)\\s+(BOS|CHOCH):\\s*([\\d.]+)\\s*(‚Üí|->)\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "ob";
                cmd.side = m[2].str();
                cmd.kind = m[3].str();  // BOS or CHOCH (backward compat)
                cmd.low = std::stof(m[4].str());
                cmd.high = std::stof(m[6].str());
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ BOS: #ID BOS Side: level ‚îÄ‚îÄ
        {
            std::regex re("#(\\d+)\\s+BOS\\s+(Bearish|Bullish):\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "bos";
                cmd.side = m[2].str();
                cmd.level = std::stof(m[3].str());
                cmd.kind = "BOS";
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ CHOCH: #ID CHOCH Side: level ‚îÄ‚îÄ
        {
            std::regex re("#(\\d+)\\s+CHOCH\\s+(Bearish|Bullish):\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "choch";
                cmd.side = m[2].str();
                cmd.level = std::stof(m[3].str());
                cmd.kind = "CHOCH";
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ FVG: #ID FVG Side: top~mid~bot ‚îÄ‚îÄ
        {
            std::regex re("#(\\d+)\\s+FVG\\s+(Bearish|Bullish):\\s*([\\d.]+)~([\\d.]+)~([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "fvg";
                cmd.side = m[2].str();
                cmd.top = std::stof(m[3].str());
                cmd.mid = std::stof(m[4].str());
                cmd.bot = std::stof(m[5].str());
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ Entry: #ID Entry Buy/Sell: price ‚îÄ‚îÄ
        {
            std::regex re("#(\\d+)\\s+Entry\\s+(Buy|Sell):\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "entry";
                cmd.direction = m[2].str();
                cmd.price = std::stof(m[3].str());
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ SL: #ID SL: price ‚îÄ‚îÄ
        {
            std::regex re("#(\\d+)\\s+SL:\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "sl";
                cmd.price = std::stof(m[2].str());
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ TP: #ID TP: price ‚îÄ‚îÄ
        {
            std::regex re("#(\\d+)\\s+TP:\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "tp";
                cmd.price = std::stof(m[2].str());
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ Line: #ID Line: price1‚Üíprice2 ‚îÄ‚îÄ
        {
            std::regex re("#(\\d+)\\s+Line:\\s*([\\d.]+)\\s*(‚Üí|->)\\s*([\\d.]+)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = "line";
                cmd.low = std::stof(m[2].str());
                cmd.high = std::stof(m[4].str());
                cmd.valid = true;
                return cmd;
            }
        }

        // ‚îÄ‚îÄ Legacy format: @#3 ob bearish 80296 80486 ‚îÄ‚îÄ
        {
            std::regex re("@#(\\d+)\\s+(\\w+)\\s*(.*)");
            std::smatch m;
            if (std::regex_search(line, m, re)) {
                cmd.ref_id = std::stoi(m[1].str());
                cmd.type = toLower(m[2].str());
                std::string rest = m[3].str();
                std::istringstream rss(rest);
                std::string token;
                while (rss >> token) {
                    std::string lower = toLower(token);
                    if (lower == "bearish" || lower == "bullish") cmd.side = capFirst(lower);
                    else if (lower == "bos") cmd.kind = "BOS";
                    else if (lower == "choch") cmd.kind = "CHOCH";
                    else if (lower == "buy" || lower == "sell") cmd.direction = capFirst(lower);
                    else {
                        try { float v = std::stof(token); params_push(cmd, v); } catch(...) {}
                    }
                }
                cmd.valid = true;
                return cmd;
            }
        }

        return cmd;
    }

    // ============================================================
    //  TRANSLATE: IsyaratCommand ‚Üí [TOOL] Execution String
    // ============================================================
    ToolExecutionResult translateToTool(const IsyaratCommand& cmd) {
        ToolExecutionResult result;
        result.command_raw = cmd.raw;

        EnvObject* obj = env.resolve(cmd.ref_id);

        // ‚îÄ‚îÄ‚îÄ OB ‚Üí chart_draw_ob ‚îÄ‚îÄ‚îÄ
        // v5: OB is just a ZONA (rectangle). Kind is optional.
        if (cmd.type == "ob") {
            if (!obj) {
                return makeError(cmd, "$ERR_NOT_FOUND",
                    "#" + std::to_string(cmd.ref_id) + " not found in ENV-CTX");
            }

            float ob_low = cmd.low;
            float ob_high = cmd.high;
            if (ob_low > ob_high) std::swap(ob_low, ob_high);

            // Timestamps dari ENV-CTX (PRIMARY source!)
            long t0 = obj->timestamp;
            long t1 = obj->timestamp_end;

            // v5: kind dari EnvObject jika ada, atau dari command (backward compat)
            // Jika cmd.kind kosong (v5 format), coba ambil dari obj
            std::string kind = cmd.kind;
            if (kind.empty() && !obj->kind.empty()) kind = obj->kind;
            if (kind.empty()) kind = "BOS";  // fallback default

            // Build label ‚Äî v5: no kind in label for cleaner display
            std::string label = "#" + std::to_string(cmd.ref_id) + " OB " + cmd.side;

            // Build JSON arguments
            char jsonBuf[512];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"extend_right\":true,\"kind\":\"%s\",\"label\":\"%s\","
                "\"ob_high\":%.2f,\"ob_low\":%.2f,\"ob_t0\":%ld,\"ob_t1\":%ld,"
                "\"side\":\"%s\"}",
                kind.c_str(), label.c_str(),
                ob_high, ob_low, t0, t1,
                cmd.side.c_str());

            result.tool_name = "chart_draw_ob";
            result.tool_args_json = jsonBuf;
            result.full_tool_str = "[TOOL] Executing: chart_draw_ob(" + std::string(jsonBuf) + ")";
            result.success = true;
            result.status_code = "$OK";
            result.message = cmd.side + " OB zone " +
                std::to_string((int)ob_low) + "-" + std::to_string((int)ob_high) +
                " (ref #" + std::to_string(cmd.ref_id) + ")";
            result.objects_drawn = 1;

            printf("[ISYARAT] %s ‚Üí %s\n", cmd.raw.c_str(), result.full_tool_str.c_str());
            return result;
        }

        // ‚îÄ‚îÄ‚îÄ BOS/CHOCH ‚Üí chart_draw_bos (LINE) ‚îÄ‚îÄ‚îÄ
        // v5: BOS/CHOCH are LINE drawing events, separate from OB zones
        if (cmd.type == "bos" || cmd.type == "choch") {
            if (!obj) {
                return makeError(cmd, "$ERR_NOT_FOUND",
                    "#" + std::to_string(cmd.ref_id) + " not found in ENV-CTX");
            }

            std::string kind = (cmd.type == "choch") ? "CHOCH" : "BOS";

            // Timestamps dari ENV-CTX (PRIMARY source!)
            long ts_swing = obj->t_swing;
            long ts_break = obj->t_break;
            float level_price = (obj->level > 0) ? obj->level : cmd.level;

            // Fallback
            if (ts_swing == 0) ts_swing = obj->timestamp;
            if (ts_break == 0) ts_break = obj->timestamp_end;

            char jsonBuf[512];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"swing_idx\":%d,\"break_idx\":%d,\"level\":%.2f,"
                "\"kind\":\"%s\",\"side\":\"%s\","
                "\"t_swing\":%ld,\"t_break\":%ld}",
                obj->candle_index, obj->break_idx, level_price,
                kind.c_str(), cmd.side.c_str(),
                ts_swing, ts_break);

            result.tool_name = "chart_draw_bos";
            result.tool_args_json = jsonBuf;
            result.full_tool_str = "[TOOL] Executing: chart_draw_bos(" + std::string(jsonBuf) + ")";
            result.success = true;
            result.status_code = "$OK";
            result.message = cmd.side + " " + kind + " at " + std::to_string((int)level_price)
                + " (swing=" + std::to_string(ts_swing) + " break=" + std::to_string(ts_break) + ")";
            result.objects_drawn = 1;

            printf("[ISYARAT] %s ‚Üí %s\n", cmd.raw.c_str(), result.full_tool_str.c_str());
            return result;
        }

        // ‚îÄ‚îÄ‚îÄ FVG ‚Üí chart_draw_ob (FVG zone) ‚îÄ‚îÄ‚îÄ
        if (cmd.type == "fvg") {
            if (!obj) {
                return makeError(cmd, "$ERR_NOT_FOUND",
                    "#" + std::to_string(cmd.ref_id) + " not found in ENV-CTX");
            }

            std::string label = "#" + std::to_string(cmd.ref_id) + " FVG " + cmd.side;

            char jsonBuf[512];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"extend_right\":true,\"kind\":\"FVG\",\"label\":\"%s\","
                "\"ob_high\":%.2f,\"ob_low\":%.2f,\"ob_t0\":%ld,\"ob_t1\":%ld,"
                "\"side\":\"%s\"}",
                label.c_str(),
                cmd.top, cmd.bot, (long)obj->timestamp, (long)0,
                cmd.side.c_str());

            result.tool_name = "chart_draw_ob";
            result.tool_args_json = jsonBuf;
            result.full_tool_str = "[TOOL] Executing: chart_draw_ob(" + std::string(jsonBuf) + ")";
            result.success = true;
            result.status_code = "$OK";
            result.message = cmd.side + " FVG " +
                std::to_string((int)cmd.bot) + "-" + std::to_string((int)cmd.top);
            result.objects_drawn = 1;

            printf("[ISYARAT] %s ‚Üí %s\n", cmd.raw.c_str(), result.full_tool_str.c_str());
            return result;
        }

        // ‚îÄ‚îÄ‚îÄ Entry ‚Üí chart_draw_line ‚îÄ‚îÄ‚îÄ
        if (cmd.type == "entry") {
            if (!obj) {
                return makeError(cmd, "$ERR_NOT_FOUND",
                    "#" + std::to_string(cmd.ref_id) + " not found in ENV-CTX");
            }

            std::string color = (cmd.direction == "Buy") ? "green" : "red";
            std::string label = "#" + std::to_string(cmd.ref_id) + " Entry " + cmd.direction;

            char jsonBuf[512];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"style\":\"dashed\",\"extend\":\"right\","
                "\"p0_candle_index\":%d,\"p0_price\":%.2f,"
                "\"p1_candle_index\":%d,\"p1_price\":%.2f,"
                "\"label\":\"%s\",\"color\":\"%s\",\"thickness\":2.0}",
                obj->candle_index, cmd.price,
                obj->candle_index + 20, cmd.price,
                label.c_str(), color.c_str());

            result.tool_name = "chart_draw_line";
            result.tool_args_json = jsonBuf;
            result.full_tool_str = "[TOOL] Executing: chart_draw_line(" + std::string(jsonBuf) + ")";
            result.success = true;
            result.status_code = "$OK";
            result.message = cmd.direction + " entry at " + std::to_string((int)cmd.price);
            result.objects_drawn = 1;

            printf("[ISYARAT] %s ‚Üí %s\n", cmd.raw.c_str(), result.full_tool_str.c_str());
            return result;
        }

        // ‚îÄ‚îÄ‚îÄ SL ‚Üí chart_draw_line ‚îÄ‚îÄ‚îÄ
        if (cmd.type == "sl") {
            if (!obj) {
                return makeError(cmd, "$ERR_NOT_FOUND",
                    "#" + std::to_string(cmd.ref_id) + " not found in ENV-CTX");
            }

            char jsonBuf[512];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"style\":\"dotted\",\"extend\":\"right\","
                "\"p0_candle_index\":%d,\"p0_price\":%.2f,"
                "\"p1_candle_index\":%d,\"p1_price\":%.2f,"
                "\"label\":\"SL: %.2f\",\"color\":\"red\",\"thickness\":1.5}",
                obj->candle_index, cmd.price,
                obj->candle_index + 30, cmd.price,
                cmd.price);

            result.tool_name = "chart_draw_line";
            result.tool_args_json = jsonBuf;
            result.full_tool_str = "[TOOL] Executing: chart_draw_line(" + std::string(jsonBuf) + ")";
            result.success = true;
            result.status_code = "$OK";
            result.message = "SL at " + std::to_string((int)cmd.price);
            result.objects_drawn = 1;

            printf("[ISYARAT] %s ‚Üí %s\n", cmd.raw.c_str(), result.full_tool_str.c_str());
            return result;
        }

        // ‚îÄ‚îÄ‚îÄ TP ‚Üí chart_draw_line ‚îÄ‚îÄ‚îÄ
        if (cmd.type == "tp") {
            if (!obj) {
                return makeError(cmd, "$ERR_NOT_FOUND",
                    "#" + std::to_string(cmd.ref_id) + " not found in ENV-CTX");
            }

            char jsonBuf[512];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"style\":\"dotted\",\"extend\":\"right\","
                "\"p0_candle_index\":%d,\"p0_price\":%.2f,"
                "\"p1_candle_index\":%d,\"p1_price\":%.2f,"
                "\"label\":\"TP: %.2f\",\"color\":\"green\",\"thickness\":1.5}",
                obj->candle_index, cmd.price,
                obj->candle_index + 30, cmd.price,
                cmd.price);

            result.tool_name = "chart_draw_line";
            result.tool_args_json = jsonBuf;
            result.full_tool_str = "[TOOL] Executing: chart_draw_line(" + std::string(jsonBuf) + ")";
            result.success = true;
            result.status_code = "$OK";
            result.message = "TP at " + std::to_string((int)cmd.price);
            result.objects_drawn = 1;

            printf("[ISYARAT] %s ‚Üí %s\n", cmd.raw.c_str(), result.full_tool_str.c_str());
            return result;
        }

        // ‚îÄ‚îÄ‚îÄ Line ‚Üí chart_draw_line ‚îÄ‚îÄ‚îÄ
        if (cmd.type == "line") {
            if (!obj) {
                return makeError(cmd, "$ERR_NOT_FOUND",
                    "#" + std::to_string(cmd.ref_id) + " not found in ENV-CTX");
            }

            std::string label = "#" + std::to_string(cmd.ref_id) + " Line";

            char jsonBuf[512];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"style\":\"dashed\",\"extend\":\"right\","
                "\"p0_candle_index\":%d,\"p0_price\":%.2f,"
                "\"p1_candle_index\":%d,\"p1_price\":%.2f,"
                "\"label\":\"%s\",\"color\":\"auto\",\"thickness\":1.2}",
                obj->candle_index, cmd.low,
                obj->candle_index + 15, cmd.high,
                label.c_str());

            result.tool_name = "chart_draw_line";
            result.tool_args_json = jsonBuf;
            result.full_tool_str = "[TOOL] Executing: chart_draw_line(" + std::string(jsonBuf) + ")";
            result.success = true;
            result.status_code = "$OK";
            result.message = "Line " + std::to_string((int)cmd.low) + "‚Üí" + std::to_string((int)cmd.high);
            result.objects_drawn = 1;

            printf("[ISYARAT] %s ‚Üí %s\n", cmd.raw.c_str(), result.full_tool_str.c_str());
            return result;
        }

        return makeError(cmd, "$ERR_INVALID", "Unknown isyarat type: " + cmd.type);
    }

    // ===== HELPERS =====

    static std::string trim(const std::string& s) {
        size_t start = s.find_first_not_of(" \t\r\n");
        size_t end = s.find_last_not_of(" \t\r\n");
        if (start == std::string::npos) return "";
        return s.substr(start, end - start + 1);
    }

    static std::string toLower(const std::string& s) {
        std::string result = s;
        std::transform(result.begin(), result.end(), result.begin(), ::tolower);
        return result;
    }

    static std::string capFirst(const std::string& s) {
        if (s.empty()) return s;
        std::string result = toLower(s);
        result[0] = std::toupper(result[0]);
        return result;
    }

private:
    void params_push(IsyaratCommand& cmd, float v) {
        if (cmd.type == "ob" || cmd.type == "line") {
            if (cmd.low == 0) cmd.low = v;
            else if (cmd.high == 0) cmd.high = v;
        } else if (cmd.type == "bos" || cmd.type == "choch") {
            if (cmd.level == 0) cmd.level = v;
        } else if (cmd.type == "entry" || cmd.type == "sl" || cmd.type == "tp") {
            cmd.price = v;
        } else if (cmd.type == "fvg") {
            if (cmd.top == 0) cmd.top = v;
            else if (cmd.mid == 0) cmd.mid = v;
            else if (cmd.bot == 0) cmd.bot = v;
        }
    }

    ToolExecutionResult makeError(const IsyaratCommand& cmd,
                                   const std::string& code,
                                   const std::string& msg) {
        ToolExecutionResult err;
        err.success = false;
        err.status_code = code;
        err.message = msg;
        err.command_raw = cmd.raw;
        printf("[ISYARAT] ERROR: %s ‚Üí %s: %s\n", cmd.raw.c_str(), code.c_str(), msg.c_str());
        return err;
    }
};

// ============================================================
//  CONSOLE LOG ‚Äî Isyarat parser results logging
// ============================================================
inline void logIsyaratResults(const std::vector<ToolExecutionResult>& results) {
    int ok = 0, err = 0;
    for (auto& r : results) {
        if (r.success) ok++; else err++;
        printf("[ISYARAT] %s | %s | %s\n",
            r.status_code.c_str(), r.command_raw.c_str(), r.message.c_str());
        if (!r.full_tool_str.empty()) {
            printf("         ‚Üí %s\n", r.full_tool_str.c_str());
        }
    }
    printf("[ISYARAT] Total: %zu commands | %d OK | %d ERR\n", results.size(), ok, err);
}

// Legacy compatibility
using SemanticParser = IsyaratParser;
using ExecutionResult = ToolExecutionResult;
#pragma once
#include <vector>
#include <string>
#include <array>
#include <map>
#include "imgui.h"
#include "Candle.h"
#include "Indicators.h"
#include "GlobalShapeManager.h"
#include "GPUCandleRenderer.h"   // ‚Üê tiap tab punya renderer sendiri
#include "OrderFlowRenderer.h"  // ‚Üê tiap tab punya OF renderer sendiri
#include "CrosshairRenderer.h"  // ‚Üê tiap tab punya crosshair state sendiri

enum CandleRenderStyle {
    RENDER_CANDLE,
    RENDER_LINE,
    RENDER_AREA,
    // ‚îÄ‚îÄ ORDER FLOW / FOOTPRINT ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
    // Candle + footprint overlay (bid/ask boxes)
    RENDER_FP_OVERLAY,
    // Footprint profile (candle tipis + grid bid/ask per level)
    RENDER_FP_PROFILE,
    // Footprint bar (proportional bar kiri=sell, kanan=buy)
    // Paling informatif, default utama untuk order flow
    RENDER_FP_BAR,

    RENDER_STYLE_COUNT  // sentinel untuk cycling
};

static inline const char* CandleStyleName(CandleRenderStyle s) {
    switch(s) {
        case RENDER_CANDLE:     return "Candle";
        case RENDER_LINE:       return "Line";
        case RENDER_AREA:       return "Area";
        case RENDER_FP_OVERLAY: return "FP Overlay";
        case RENDER_FP_PROFILE: return "FP Profile";
        case RENDER_FP_BAR:     return "FP Bar";
        default:                return "Candle";
    }
}

// Apakah style ini mode order flow?
static inline bool IsFootprintStyle(CandleRenderStyle s) {
    return s == RENDER_FP_OVERLAY
        || s == RENDER_FP_PROFILE
        || s == RENDER_FP_BAR;
}

// ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
// State zoom/pan independen per-tab
// ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
struct ChartTabState {
    double y_min=0, y_max=0;
    bool   autoFitY=true;
    float  zoomLevel=150.f, targetZoom=150.f;
    int    viewCenterIndex=0;
    double dragAccumulator=0;
    float  inertiaVelocity=0;
    bool   isInertiaActive=false;
    bool   isResizingY=false, isPanConfirmed=false, lastTouchState=false;
    ImVec2 panStartPos={0,0};

    // ‚îÄ‚îÄ GoToLive per-tab ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
    // Setiap tab punya animasi sendiri ‚Üí multi-tab semua bisa go live
    bool   isAnimatingToLive = false; // sedang smooth-lerp ke candle live
    double animFloatingIndex = 0.0;   // posisi floating animasi (sub-candle)
    ImVec2 savedPlotPos      = {0.f, 0.f}; // disimpan saat BeginPlot
    ImVec2 savedPlotSize     = {0.f, 0.f}; // disimpan saat BeginPlot
    bool   plotBoundsReady   = false;       // true setelah frame pertama render
};

// ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
// Satu tab chart
// ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
struct ChartTab {
    int         id        = -1;
    std::string symbol    = "XAUUSD";
    std::string timeframe = "M1";
    std::string label     = "XAUUSD M1";

    // true  = pakai g_allCandles (tab utama / default)
    // false = punya data sendiri (tab tambahan)
    bool usesGlobalData   = true;
    // true = tab extra yang dibuat saat replay (dihapus otomatis saat exit replay)
    // Data source: g_allCandles[tf] langsung (bukan SYMBOL_TF)
    // limitIndex: g_tfIndices[tf] ‚Äî ikut sync replay engine
    bool isReplayExtraTab  = false;

    // üìñ ORDER BOOK TAB ‚Äî tab khusus tampilkan L2 OB
    // Tidak ada candle, tidak ada chart ‚Äî hanya OB panel full-window
    // Symbol: ikut tab->symbol (bisa berbeda tiap tab)
    // TF: "OB" (tidak relevan)
    bool isOrderBookTab    = false;

    std::vector<Indicator*> indicators;
    GlobalShapeManager      shapes;
    ChartTabState           state;       // zoom/pan sendiri
    CrosshairState          crosshair;   // crosshair state per-tab

    // üî• GPU RENDERER PER-TAB
    // Setiap tab punya VBO sendiri ‚Üí candle M15 tidak tumpuk H4
    GPUCandleRenderer gpuRenderer;
    bool gpuInitialized = false;

    // üî• ORDER FLOW RENDERER PER-TAB (analogi GPUCandleRenderer)
    // Setiap tab punya instance sendiri dengan symbol & tickSize yang benar.
    // Tab BTCUSDT M15 tidak akan pakai tickSize XAUUSD, dan sebaliknya.
    // fpZoom per-tab (Ctrl+Scroll) juga disimpan di sini, bukan di ChartTab.
    OrderFlowRenderer orderFlowRenderer;

    CandleRenderStyle renderStyle = RENDER_CANDLE;
    ImVec4 lineColor = {0.2f, 0.7f, 1.f, 1.f};

    // üî• VP OVERLAY ‚Äî layer tambahan, independen dari renderStyle
    // Bisa aktif di atas SEMUA style: Candle, FP Bar, FP Profile, dll.
    // Toggle via tombol "VP" di toolbar ‚Äî amber kalau ON.
    // Render: DrawVolumeProfile() dipanggil SETELAH switch(renderStyle)
    bool showVolumeProfile = false;

    // ‚îÄ‚îÄ SMART SYNC (Zero Copy Per Frame) ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
    // Buffer candle milik tab ini ‚Äî tidak di-copy ulang tiap frame
    // Hanya update selisih yang berubah (lihat RenderSingleChartWindow)
    std::vector<Candle> localCandles;
    std::string         lastTF = "";   // deteksi TF berubah ‚Üí copy full

    // ‚îÄ‚îÄ REPLAY ANIMASI PER-TAB ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
    // Masing-masing tab track high/low candle live-nya sendiri
    // Semua tab animate saat replay (bukan hanya tab utama)
    double replayMemHigh  = 0;
    double replayMemLow   = 0;
    double replayLastTime = 0;

    bool isOpen    = true;
    bool isLoading = false;

    // üî• PER-TAB LAZY LOAD STATE
    // lazyPending  = true saat C++ sudah trigger JS, tunggu JS selesai rebuild
    // noMoreHistory= true saat server konfirmasi sudah tidak ada data lebih lama
    //                ‚Üí tidak perlu trigger lazy lagi untuk symbol ini
    bool lazyPending    = false;
    bool noMoreHistory  = false;

    // ‚îÄ‚îÄ DOCKING MEMORY ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
    // Saat symbol/TF berubah ‚Üí judul window berubah ‚Üí ImGui anggap window baru.
    // Kita simpan posisi & ukuran lama, lalu restore di frame berikutnya.
    ImVec2 savedPos          = {-1.f, -1.f}; // -1 = belum ada
    ImVec2 savedSize         = {600.f, 400.f};
    bool   pendingRestore    = false;         // true ‚Üí SetNextWindowPos dengan Always

    // ‚îÄ‚îÄ DOCK ID MEMORY ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
    // Saat symbol/TF berubah ‚Üí nama window beda ‚Üí ImGui kehilangan DockId.
    // Kita simpan DockId sebelum perubahan, lalu SetNextWindowDockID() restore.
    unsigned int savedDockId = 0;             // 0 = belum ada / tidak dock
    bool         pendingDockRestore = false;   // true ‚Üí SetNextWindowDockID di frame berikutnya

    void UpdateLabel() {
        if (isOrderBookTab)
            label = symbol + " | OB";
        else
            label = symbol + " | " + timeframe;
    }

    void ClearIndicators() {
        for (auto* i : indicators) delete i;
        indicators.clear();
    }

    // Init GPU renderer tab ini (panggil 1x)
    void InitGPU() {
        if (!gpuInitialized) {
            gpuRenderer.Init();
            gpuInitialized = true;
        }
    }

    // Init OrderFlow renderer dengan symbol tab ini
    // Panggil setelah symbol diset (di AddTab atau LoadTabSymbol)
    void InitOrderFlow() {
        orderFlowRenderer.SetSymbol(symbol);
    }

    // Sinkron warna dari global (biar tema berlaku ke semua tab)
    void SyncColors(ImVec4 bull, ImVec4 bear) {
        gpuRenderer.colorBull     = bull;
        gpuRenderer.colorBear     = bear;
        gpuRenderer.wickColorBull = bull;
        gpuRenderer.wickColorBear = bear;
    }

    ~ChartTab() {
        ClearIndicators();
        gpuRenderer.Shutdown();
    }
};

// ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
// Manager
// ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
class MultiChartManager {
public:
    std::vector<ChartTab*> tabs;
    int activeTabId = -1, nextId = 0;

    ChartTab* AddTab(const std::string& sym, const std::string& tf,
                     bool usesGlobal = true) {
        ChartTab* t   = new ChartTab();
        t->id         = nextId++;
        t->symbol     = sym;
        t->timeframe  = tf;
        t->usesGlobalData = usesGlobal;
        t->UpdateLabel();
        tabs.push_back(t);
        activeTabId = t->id;
        return t;
    }

    void RemoveTab(int id) {
        for (int i = 0; i < (int)tabs.size(); i++) {
            if (tabs[i]->id == id) {
                delete tabs[i];
                tabs.erase(tabs.begin() + i);
                if (activeTabId == id)
                    activeTabId = tabs.empty() ? -1 : tabs[std::max(0,i-1)]->id;
                return;
            }
        }
    }

    ChartTab* GetActiveTab() {
        for (auto* t : tabs) if (t->id == activeTabId) return t;
        return nullptr;
    }

    ChartTab* GetById(int id) {
        for (auto* t : tabs) if (t->id == id) return t;
        return nullptr;
    }

    bool IsEmpty() const { return tabs.empty(); }

    ~MultiChartManager() { for (auto* t : tabs) delete t; }
};

extern MultiChartManager g_chartManager;
extern ChartTab*         g_activeChart;
